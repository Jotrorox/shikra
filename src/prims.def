/* prims.def -- the table of %primitives (DESIGN.md §2, §6). X-macro: define PRIM, include.
 *
 *   PRIM(NAME, WHO, CFN, ARITY, ARGS, RES, FLAGS)
 *
 *   NAME   string  name the expander emits in (%prim arg ...) forms, e.g. "%car"
 *   WHO    string  user-visible procedure name used in error messages, e.g. "car"
 *   CFN    ident   runtime C function. Fixed arity: obj CFN(obj, ...) taking exactly ARITY
 *                  arguments (0-arity: obj CFN(void)). The naive backend emits CFN(args...);
 *                  the VM builds a table of function pointers from this file.
 *   ARITY  int     number of arguments. (Reserved: -1-n would mean "n or more", with
 *                  obj CFN(intptr_t argc, obj *argv); no row uses it yet.)
 *   ARGS   string  one type letter per argument, as the primitive CHECKS it
 *   RES    char    type letter of the result
 *   FLAGS  int     PF_* bits, or 0
 *
 * Type letters (spec §5.2 lattice, plus two unions):
 *   a any     f fixnum   d flonum   n number (f|d)   c char     b boolean
 *   p pair    e null     l list (p|e)                s string   y symbol
 *   v vector  u bytevector          x procedure      r record   (ports, error objects,
 *   boxes, values and unspecified results are 'a')
 *
 * Flags (define them before including; suggested values):
 *   PF_PURE    no side effects and no observable allocation identity: may be folded,
 *              hoisted, CSE'd or deleted when unused (if it cannot fail, or args are known)
 *   PF_ALLOC   may allocate a fresh object (eq?-distinct result)
 *   PF_FAIL    may raise an error (type/range check, overflow, I/O)
 *   PF_EFFECT  mutates memory or performs I/O: never reorder or delete
 *
 * Optional arguments are filled in by the Scheme library (lib/), never here: every
 * primitive has an exact arity. The four engine-specific control operations (%call/cc,
 * %apply, %values, %call-with-values) are NOT in this table; each engine implements them.
 * Record primitives take the record-type descriptor explicitly; %record-ref/-set! take a
 * compiler-constant field index (unchecked). */

/* pairs and lists */
PRIM("%cons", "cons", rt_cons, 2, "aa", 'p', PF_ALLOC)
PRIM("%car", "car", rt_car, 1, "p", 'a', PF_FAIL)
PRIM("%cdr", "cdr", rt_cdr, 1, "p", 'a', PF_FAIL)
PRIM("%set-car!", "set-car!", rt_set_car, 2, "pa", 'a', PF_FAIL | PF_EFFECT)
PRIM("%set-cdr!", "set-cdr!", rt_set_cdr, 2, "pa", 'a', PF_FAIL | PF_EFFECT)
PRIM("%pair?", "pair?", rt_pair_p, 1, "a", 'b', PF_PURE)
PRIM("%null?", "null?", rt_null_p, 1, "a", 'b', PF_PURE)
PRIM("%list?", "list?", rt_list_p, 1, "a", 'b', 0)
PRIM("%length", "length", rt_length, 1, "l", 'f', PF_FAIL)
PRIM("%reverse", "reverse", rt_reverse, 1, "l", 'l', PF_ALLOC | PF_FAIL)
PRIM("%append2", "append", rt_append2, 2, "la", 'a', PF_ALLOC | PF_FAIL)

/* equivalence, booleans, procedures */
PRIM("%eq?", "eq?", rt_eq_p, 2, "aa", 'b', PF_PURE)
PRIM("%eqv?", "eqv?", rt_eqv_p, 2, "aa", 'b', PF_PURE)
PRIM("%equal?", "equal?", rt_equal_p, 2, "aa", 'b', 0)
PRIM("%boolean?", "boolean?", rt_boolean_p, 1, "a", 'b', PF_PURE)
PRIM("%procedure?", "procedure?", rt_procedure_p, 1, "a", 'b', PF_PURE)

/* symbols */
PRIM("%symbol?", "symbol?", rt_symbol_p, 1, "a", 'b', PF_PURE)
PRIM("%symbol->string", "symbol->string", rt_symbol_to_string, 1, "y", 's', PF_FAIL)
PRIM("%string->symbol", "string->symbol", rt_string_to_symbol, 1, "s", 'y', PF_ALLOC | PF_FAIL)

/* chars */
PRIM("%char?", "char?", rt_char_p, 1, "a", 'b', PF_PURE)
PRIM("%char->integer", "char->integer", rt_char_to_integer, 1, "c", 'f', PF_FAIL)
PRIM("%integer->char", "integer->char", rt_integer_to_char, 1, "f", 'c', PF_FAIL)
/* (scheme char): ASCII, or the Unicode tables with --unicode=full */
PRIM("%char-upcase", "char-upcase", rt_char_upcase, 1, "c", 'c', PF_FAIL)
PRIM("%char-downcase", "char-downcase", rt_char_downcase, 1, "c", 'c', PF_FAIL)
PRIM("%char-foldcase", "char-foldcase", rt_char_foldcase, 1, "c", 'c', PF_FAIL)
