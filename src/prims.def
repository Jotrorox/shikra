/* ---- (shikra ...) extension libraries (spec §10; rt_ext.c, DESIGN.md "Extensions as built").
 * Type letter w: f64vector. The compiler specialises most of them (emit.c ext_special); the
 * functions below are the checked generic forms (the interpreter, unproven arguments). */
/* (shikra fixnum), SRFI 143: fixnum-only, overflow raises (wraps only with --unsafe) */
PRIM("%fx+", "fx+", rt_fx_add, 2, "ff", 'f', PF_FAIL)
PRIM("%fx-", "fx-", rt_fx_sub, 2, "ff", 'f', PF_FAIL)
PRIM("%fx*", "fx*", rt_fx_mul, 2, "ff", 'f', PF_FAIL)
PRIM("%fxneg", "fxneg", rt_fx_neg, 1, "f", 'f', PF_FAIL)
PRIM("%fxabs", "fxabs", rt_fx_abs, 1, "f", 'f', PF_FAIL)
PRIM("%fxsquare", "fxsquare", rt_fx_square, 1, "f", 'f', PF_FAIL)
PRIM("%fxquotient", "fxquotient", rt_fx_quotient, 2, "ff", 'f', PF_FAIL)
PRIM("%fxremainder", "fxremainder", rt_fx_remainder, 2, "ff", 'f', PF_FAIL)
PRIM("%fxmax", "fxmax", rt_fx_max, 2, "ff", 'f', PF_FAIL)
PRIM("%fxmin", "fxmin", rt_fx_min, 2, "ff", 'f', PF_FAIL)
PRIM("%fx=?", "fx=?", rt_fx_eq, 2, "ff", 'b', PF_FAIL)
PRIM("%fx<?", "fx<?", rt_fx_lt, 2, "ff", 'b', PF_FAIL)
PRIM("%fx>?", "fx>?", rt_fx_gt, 2, "ff", 'b', PF_FAIL)
PRIM("%fx<=?", "fx<=?", rt_fx_le, 2, "ff", 'b', PF_FAIL)
PRIM("%fx>=?", "fx>=?", rt_fx_ge, 2, "ff", 'b', PF_FAIL)
