PRIM("%read-error?", "read-error?", rt_read_error_p, 1, "a", 'b', PF_PURE)
/* report an uncaught exception and exit (the bottom of raise in lib/) */
PRIM("%uncaught", "raise", rt_uncaught_o, 1, "a", 'a', PF_EFFECT)

/* dynamic state (spec §8.3, §8.4): the winders list (dynamic-wind and parameterize frames)
 * and the handler stack are runtime globals; lib/ implements everything on top of these */
PRIM("%winders", "winders", rt_winders_get, 0, "", 'l', 0)
PRIM("%set-winders!", "winders", rt_winders_set, 1, "l", 'a', PF_EFFECT)
