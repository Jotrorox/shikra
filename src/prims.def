PRIM("%char-lower-case?", "char-lower-case?", rt_char_lower_case_p, 1, "c", 'b', PF_FAIL)
PRIM("%digit-value", "digit-value", rt_digit_value, 1, "c", 'a', PF_FAIL)
PRIM("%string-upcase", "string-upcase", rt_string_upcase, 1, "s", 's', PF_ALLOC | PF_FAIL)
PRIM("%string-downcase", "string-downcase", rt_string_downcase, 1, "s", 's', PF_ALLOC | PF_FAIL)
PRIM("%string-foldcase", "string-foldcase", rt_string_foldcase, 1, "s", 's', PF_ALLOC | PF_FAIL)

/* strings */
