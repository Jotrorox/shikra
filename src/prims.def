PRIM("%set-handlers!", "handlers", rt_handlers_set, 1, "l", 'a', PF_EFFECT)
PRIM("%parameter-binding", "parameter", rt_parameter_binding, 1, "p", 'p', PF_FAIL)
PRIM("%continuation-live?", "continuation", rt_continuation_live_p, 1, "a", 'b', 0)

/* multiple-values object (values flowing to an unknown receiver) */
PRIM("%make-values", "values", rt_make_values, 1, "l", 'a', PF_ALLOC | PF_FAIL)
PRIM("%values?", "values?", rt_values_p, 1, "a", 'b', PF_PURE)
PRIM("%values->list", "values->list", rt_values_to_list, 1, "a", 'l', PF_ALLOC | PF_FAIL)
/* spreading a values object into a known receiver (emitted by normalize.c; nreq, i and
