PRIM("%string-set!", "string-set!", rt_string_set, 3, "sfc", 'a', PF_FAIL | PF_EFFECT)
PRIM("%substring", "substring", rt_substring, 3, "sff", 's', PF_ALLOC | PF_FAIL)
PRIM("%string-copy!", "string-copy!", rt_string_copy_x, 5, "sfsff", 'a', PF_FAIL | PF_EFFECT)
PRIM("%string-fill!", "string-fill!", rt_string_fill_x, 4, "scff", 'a', PF_FAIL | PF_EFFECT)
PRIM("%string-append", "string-append", rt_string_append, 2, "ss", 's', PF_ALLOC | PF_FAIL)
