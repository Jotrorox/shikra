;; (shikra flonum): constants (correctly rounded; computed with 60-digit decimal arithmetic),
;; predicates, folds and the small procedures of SRFI 144.
(begin
  (define fl-e 2.718281828459045)
  (define fl-1/e 0.36787944117144233)
  (define fl-e-2 7.38905609893065)
  (define fl-e-pi/4 2.1932800507380152)
  (define fl-log2-e 1.4426950408889634)
  (define fl-log10-e 0.4342944819032518)
  (define fl-log-2 0.6931471805599453)
  (define fl-1/log-2 1.4426950408889634)
  (define fl-log-3 1.0986122886681098)
  (define fl-log-pi 1.1447298858494002)
  (define fl-log-10 2.302585092994046)
  (define fl-1/log-10 0.4342944819032518)
  (define fl-pi 3.141592653589793)
  (define fl-1/pi 0.3183098861837907)
  (define fl-2pi 6.283185307179586)
  (define fl-pi/2 1.5707963267948966)
  (define fl-pi/4 0.7853981633974483)
  (define fl-pi-squared 9.869604401089358)
  (define fl-degree 0.017453292519943295)
  (define fl-2/pi 0.6366197723675814)
  (define fl-2/sqrt-pi 1.1283791670955126)
  (define fl-sqrt-pi 1.772453850905516)
  (define fl-sqrt-2 1.4142135623730951)
  (define fl-sqrt-3 1.7320508075688772)
  (define fl-sqrt-5 2.23606797749979)
  (define fl-sqrt-10 3.1622776601683795)
  (define fl-1/sqrt-2 0.7071067811865476)
  (define fl-cbrt-2 1.2599210498948732)
  (define fl-cbrt-3 1.4422495703074083)
  (define fl-4thrt-2 1.189207115002721)
  (define fl-phi 1.618033988749895)
  (define fl-log-phi 0.48121182505960347)
  (define fl-1/log-phi 2.0780869212350277)
  (define fl-euler 0.5772156649015329)
  (define fl-e-euler 1.781072417990198)
  (define fl-sin-1 0.8414709848078965)
  (define fl-cos-1 0.5403023058681398)
  (define fl-gamma-1/2 1.772453850905516)
  (define fl-gamma-1/3 2.6789385347077475)
  (define fl-gamma-2/3 1.3541179394264005)
  (define fl-greatest 1.7976931348623157e308)
  (define fl-least 4.9406564584124654e-324)
  (define fl-epsilon 2.220446049250313e-16)
  (define fl-fast-fl+* (%fl-fast-fma))
  (define fl-integer-exponent-zero (%flinteger-exponent 0.0))
  (define fl-integer-exponent-nan (%flinteger-exponent +nan.0))

  (define (flonum? x) (%flonum? x))
  (define (flonum x) (if (%flonum? x) x (if (%number? x) (%inexact x) (error "flonum: expected number" x))))
  (define (fladjacent x y) (%fladjacent x y))
  (define (flcopysign x y) (%flcopysign x y))
  (define (make-flonum x n) (%make-flonum x n))
  (define (flexponent x) (%flexponent x))
  (define (flinteger-exponent x) (%flinteger-exponent x))
  (define (flsign-bit x) (%flsign-bit x))
  (define (flinteger-fraction x)
    (let ((i (%fltruncate x)))
      (%values i (%flcopysign (if (%fl=? (%flabs x) +inf.0) 0.0 (%fl- x i)) x))))
  (define (flnormalized-fraction-exponent x)
    (if (if (%fl=? x 0.0) #t (%fl=? (%fl- x x) 0.0))
        (if (%fl=? x 0.0)
            (%values x 0)
            (let ((e (%+ (%flinteger-exponent x) 1)))
              (%values (%make-flonum x (%- 0 e)) e)))
        (%values x 0)))

  (define-syntax define-flcompare
    (syntax-rules ()
      ((_ name prim)
       (define name
         (case-lambda
           ((a b) (prim a b))
           ((a) (prim a a) #t)
           ((a b c) (let ((ok (prim a b))) (if (prim b c) ok #f)))
           ((a b . rest)
            (let loop ((x b) (rest rest) (ok (prim a b)))
              (if (%null? rest)
                  ok
                  (let ((y (%car rest)))
                    (loop y (%cdr rest) (if (prim x y) ok #f)))))))))))
  (define-flcompare fl=? %fl=?)
  (define-flcompare fl<? %fl<?)
  (define-flcompare fl>? %fl>?)
  (define-flcompare fl<=? %fl<=?)
  (define-flcompare fl>=? %fl>=?)
  (define (flnan? x) (if (%fl=? x x) #f #t))
  (define (flunordered? x y) (if (%fl=? x x) (if (%fl=? y y) #f #t) (begin (%fl=? y y) #t)))
  (define (flfinite? x) (%fl=? (%fl- x x) 0.0))
  (define (flinfinite? x) (%fl=? (%flabs x) +inf.0))
  (define (flinteger? x) (if (%fl=? (%fl- x x) 0.0) (%fl=? x (%fltruncate x)) #f))
  (define (flzero? x) (%fl=? x 0.0))
  (define (flpositive? x) (%fl>? x 0.0))
  (define (flnegative? x) (%fl<? x 0.0))
  (define (flodd? x)
    (if (flinteger? x) (%fl=? (%flabs (%flremainder x 2.0)) 1.0) (error "flodd?: expected integral flonum" x)))
  (define (fleven? x)
    (if (flinteger? x) (%fl=? (%flremainder x 2.0) 0.0) (error "fleven?: expected integral flonum" x)))
  (define (flnormalized? x) (let ((a (%flabs x))) (if (%fl>=? a 2.2250738585072014e-308) (%fl<? a +inf.0) #f)))
  (define (fldenormalized? x) (let ((a (%flabs x))) (if (%fl>? a 0.0) (%fl<? a 2.2250738585072014e-308) #f)))

  (define-syntax define-flfold
    (syntax-rules ()
      ((_ name prim none one)
       (define name
         (case-lambda
           (() none)
           ((a) (prim a one))
           ((a b) (prim a b))
           ((a b c) (prim (prim a b) c))
           ((a b . rest)
            (let loop ((acc (prim a b)) (rest rest))
              (if (%null? rest) acc (loop (prim acc (%car rest)) (%cdr rest))))))))))
  (define-flfold fl+ %fl+ 0.0 -0.0)
  (define-flfold fl* %fl* 1.0 1.0)
  (define-flfold flmax %flmax -inf.0 -inf.0)
  (define-flfold flmin %flmin +inf.0 +inf.0)
  (define-syntax define-flinverse
    (syntax-rules ()
      ((_ name prim one)
       (define name
         (case-lambda
           ((a) (prim one a))
           ((a b) (prim a b))
           ((a b c) (prim (prim a b) c))
           ((a b . rest)
            (let loop ((acc (prim a b)) (rest rest))
              (if (%null? rest) acc (loop (prim acc (%car rest)) (%cdr rest))))))))))
  (define-flinverse fl- %fl- -0.0)
  (define-flinverse fl/ %fl/ 1.0)
  (define (fl+* x y z) (%fl+* x y z))
  (define (flabs x) (%flabs x))
  (define (flabsdiff x y) (%flabs (%fl- x y)))
  (define (flposdiff x y) (let ((d (%fl- x y))) (if (%fl<? d 0.0) 0.0 d)))
  (define (flsgn x) (%flcopysign 1.0 x))
  (define (flnumerator x)
    (if (if (%fl=? (%fl- x x) 0.0) (%fl=? x 0.0) #t) x (numerator x)))
  (define (fldenominator x)
    (cond ((flnan? x) x) ((%fl=? (%fl- x x) 0.0) (denominator x)) (else 1.0)))
  (define (flfloor x) (%flfloor x))
  (define (flceiling x) (%flceiling x))
  (define (flround x) (%flround x))
  (define (fltruncate x) (%fltruncate x))

  (define (flexp x) (%flexp x))
  (define (flexp2 x) (%flexpt 2.0 x))
  (define (flsquare x) (%fl* x x))
  (define (flsqrt x) (%flsqrt x))
  (define (flexpt x y) (%flexpt x y))
  (define (fllog x) (%fllog x))
  (define (make-fllog-base b)
    (let ((lb (%fllog b))) (lambda (x) (%fl/ (%fllog x) lb))))
  (define (flsin x) (%flsin x))
  (define (flcos x) (%flcos x))
  (define (fltan x) (%fltan x))
  (define (flasin x) (%flasin x))
  (define (flacos x) (%flacos x))
  (define flatan
    (case-lambda
      ((x) (%flatan x))
      ((y x) (%flatan2 y x))))
  (define (flquotient x y) (%fltruncate (%fl/ x y)))
  (define (flremainder x y) (%flremainder x y))
  (define (flremquo x y) (%values (%flremquo x y) (%flremquo-bits x y))))
