  list->f64vector))
(define (kinds l) (map (lambda (x) (cond ((procedure? x) 'p) ((boolean? x) 'b) ((exact-integer? x) 'i) (else 'f))) l))
(write (list (length fixnum-names) (length flonum-names) (length f64vector-names)))
(newline)
(write (kinds fixnum-names)) (newline)
(write (kinds flonum-names)) (newline)
(define-c c-abs "abs" (int) int)
(write (list (assume (c-abs -3)) (kinds f64vector-names)))
(newline)
