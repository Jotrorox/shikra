;; Proper tail calls through apply, call-with-values (consumer) and inside a guard body or a
;; dynamic-wind thunk (themselves not tail contexts): 10^6 iterations in constant stack.
(import (scheme base) (scheme write))
(define (show x) (write x) (newline))
(define (via-apply n) (if (= n 0) 'apply-done (apply via-apply (list (- n 1)))))
(show (via-apply 1000000))
(define (via-apply* n acc) (if (= n 0) acc (apply via-apply* (- n 1) (list (+ acc 1)))))
(show (via-apply* 1000000 0))
(define (via-cwv n) (if (= n 0) 'cwv-done (call-with-values (lambda () (- n 1)) via-cwv)))
(show (via-cwv 1000000))
(define (via-cwv2 n) (if (= n 0) 'cwv2-done (call-with-values (lambda () (values (- n 1))) (lambda (m) (via-cwv2 m)))))
(show (via-cwv2 1000000))
(define (via-values n) (if (= n 0) 'values-done (call-with-values (lambda () (values n 1)) (lambda (a b) (via-values (- a b))))))
(show (via-values 1000000))
(define (count-up n) (let loop ((i 0)) (if (< i n) (loop (+ i 1)) i)))
(show (guard (e (#t 'no)) (count-up 1000000)))
(define (mutual-a n) (if (= n 0) 'guard-body-done (mutual-b (- n 1))))
(define (mutual-b n) (mutual-a n))
(show (guard (e (#t 'no)) (mutual-a 1000000)))
(show (dynamic-wind (lambda () #f) (lambda () (mutual-a 1000000)) (lambda () #f)))
(show (with-exception-handler (lambda (e) 0) (lambda () (mutual-a 1000000))))
;; apply complete
(show (list (apply + (list 3 4)) (apply + 1 2 '(3 4)) (apply list '()) (apply max 1 '(5 2))))
(define compose (lambda (f g) (lambda args (f (apply g args)))))
(show ((compose (lambda (x) (* x x)) *) 2 3))
