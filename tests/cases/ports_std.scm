;; The standard port parameters (M4-2): static cells, shallow parameterize (swapped in and out,
;; also on escapes and errors), the setter, and closing the standard output (the analysis must
;; then keep the port checks: writing to it raises).
(import (scheme base) (scheme write))
(define sp (open-output-string))
(parameterize ((current-output-port sp)) (display "inner") (newline))
(display (get-output-string sp))
(define sp2 (open-output-string))
(display (call/cc (lambda (k) (parameterize ((current-output-port sp2)) (display "a") (k 1)))))
(display " after escape: ")
(display (get-output-string sp2))
(newline)
(display (guard (e (#t 'caught)) (parameterize ((current-output-port sp2)) (display "b") (car (list)))))
(display (get-output-string sp2))
(newline)
(define saved (current-output-port))
(current-output-port sp2)
(display "c")
(current-output-port saved)
(display (get-output-string sp2))
(newline)
(parameterize ((current-output-port sp2) (current-output-port sp)) (display "dup"))
(display (list (get-output-string sp) (get-output-string sp2)))
(newline)
(display 42)
(newline)
(close-port (current-output-port))
(guard (e ((error-object? e) (write-string (error-object-message e) (current-error-port)) (newline (current-error-port))))
  (display "lost"))
