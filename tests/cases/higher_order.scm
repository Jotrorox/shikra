;; Higher-order procedures of (scheme base) with several list/vector/string arguments
;; (R7RS 6.10).
(import (scheme base) (scheme write))
(define (show x) (write x) (newline))
(show (map cadr '((a b) (d e) (g h))))
(show (map + '(1 2 3) '(10 20 30)))
(show (map + '(1 2 3) '(10 20) '(100 200 300)))
(show (map (lambda (x y z) (list x y z)) '(1 2) '(a b) '("p" "q")))
(show (let ((count 0)) (map (lambda (ignored) (set! count (+ count 1)) count) '(a b))))
(show (string-map (lambda (c) (if (char=? c #\a) #\A c)) "banana"))
(show (string-map (lambda (a b) (if (char<? a b) a b)) "adcz" "bbbbbbb"))
(show (vector-map cadr '#((a b) (d e) (g h))))
(show (vector-map + '#(1 2) '#(10 20 30)))
(show (let ((v (make-vector 5)))
        (for-each (lambda (i) (vector-set! v i (* i i))) '(0 1 2 3 4))
        v))
(show (let ((acc '())) (for-each (lambda (x y) (set! acc (cons (+ x y) acc))) '(1 2 3) '(10 20)) acc))
(show (let ((v '())) (string-for-each (lambda (c) (set! v (cons (char->integer c) v))) "abcde") v))
(show (let ((v '())) (string-for-each (lambda (a b) (set! v (cons (list a b) v))) "ab" "xyz") v))
(show (let ((v (make-list 5)))
        (vector-for-each (lambda (i) (list-set! v i (* i i))) '#(0 1 2 3 4))
        v))
(show (let ((acc 0)) (vector-for-each (lambda (a b) (set! acc (+ acc (* a b)))) '#(1 2 3) '#(4 5)) acc))
(show (procedure? car))
(show (procedure? 'car))
(show (procedure? (lambda (x) (* x x))))
(show (call-with-current-continuation procedure?))
