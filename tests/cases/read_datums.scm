;; (scheme read): every kind of datum from string ports, datum labels, comments and
;; directives, read errors (read-error?), and end of file; then whatever stdin holds
;; (read_datums.in), datum by datum, written back.
(import (scheme base) (scheme read) (scheme write) (util check))

(define (r s) (read (open-input-string s)))
(define (all s) (let ((p (open-input-string s)))
                  (let loop ((acc '())) (let ((x (read p))) (if (eof-object? x) (reverse acc) (loop (cons x acc)))))))
(define (read-error s) (guard (e ((read-error? e) 'read-error) (#t (list 'other e))) (r s)))
(check (r "42") 42)
(check (r "-17") -17)
(check (r "#x-ff") -255)
(check (r "1.5e3") 1500.0)
(check (r ".5") 0.5)
(check (r "-0.0") -0.0)
(check (r "+inf.0") +inf.0)
(check (r "1/2") 0.5)
(check (r "#e1.5e2") 150)
(check (r "#t") #t)
(check (r "#false") #f)
(check (r "#\\a") #\a)
(check (r "#\\space") #\space)
(check (r "#\\x41") #\A)
(check (r "#\\λ") (integer->char 955))
(check (r "\"a\\tb\\x41;\\\\\"") "a\tbA\\")
(check (r "abc") 'abc)
(check (r "|a b|") (string->symbol "a b"))
(check (r "#!fold-case ABC") 'abc)
(check (r "()") '())
(check (r "(1 . 2)") '(1 . 2))
(check (r "(a (b c) . d)") '(a (b c) . d))
(check (r "#(1 #(2) \"x\")") '#(1 #(2) "x"))
(check (r "#u8(0 255 7)") (bytevector 0 255 7))
(check (r "'x") ''x)
(check (r "`(a ,b ,@c)") '`(a ,b ,@c))
(check (r "; comment\n #| block #| nested |# |# #;(skipped) kept") 'kept)
(check (all "1 \"two\" (3) #(4) five") '(1 "two" (3) #(4) five))
(check (eof-object? (r "")) #t)
(check (eof-object? (r "   ; only a comment\n")) #t)
(define cyc (r "#0=(a b . #0#)"))
(check (eq? cyc (cddr cyc)) #t)
(define shared (r "(#1=(x) #1# #1#)"))
(check (and (eq? (car shared) (cadr shared)) (eq? (car shared) (list-ref shared 2))) #t)
(define vcyc (r "#2=#(1 #2#)"))
(check (eq? vcyc (vector-ref vcyc 1)) #t)
(check (read-error ")") 'read-error)
(check (read-error "(1 2") 'read-error)
(check (read-error "\"abc") 'read-error)
(check (read-error "#<foo>") 'read-error)
(check (read-error "#\\nosuchname") 'read-error)
(check (read-error "(1 . 2 3)") 'read-error)
(check (read-error "#u8(256)") 'read-error)
(check (read-error "#5#") 'read-error)
(check (read-error "99999999999999999999") 'read-error)
;; a port keeps its position between reads
(define p (open-input-string "(a) b \"c\""))
(check (list (read p) (read p) (read p) (eof-object? (read p))) '((a) b "c" #t))
(check-done)
;; stdin
(let loop ()
  (let ((x (read)))
    (unless (eof-object? x)
      (write x) (newline)
      (loop))))
