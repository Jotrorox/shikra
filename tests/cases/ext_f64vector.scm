;; (shikra f64vector): construction, access, printing (#f64(...)), reading, equal?, literals
;; (read-only), errors; a dot product and a vector filled in a loop (unboxed in compiled code).
(import (scheme base) (scheme write) (scheme read) (shikra f64vector) (util check))
(define v (make-f64vector 3 1.5))
(check (f64vector? v) #t)
(check (map f64vector? (list (vector 1.0) (bytevector 1) 1.0 '())) '(#f #f #f #f))
(check (f64vector-length v) 3)
(f64vector-set! v 1 2)
(f64vector-set! v 2 -0.25)
(check (f64vector->list v) '(1.5 2.0 -0.25))
(check (f64vector-ref v 1) 2.0)
(check (f64vector->list (make-f64vector 2)) '(0.0 0.0))
(check (f64vector-length (make-f64vector 0)) 0)
(check (equal? v (f64vector 1.5 2 -0.25)) #t)
(check (equal? v (f64vector 1.5 2 0.25)) #f)
(check (equal? (f64vector 0.0) (f64vector -0.0)) #f)
(check (equal? (list->f64vector '(1 2.5)) #f64(1.0 2.5)) #t)
(check (eqv? v v) #t)
(write v) (newline)
(display (list (f64vector) (f64vector +inf.0 -inf.0 1e-300 123456.75))) (newline)
(write '(#f64(1 2) #f64())) (newline)
(define p (open-input-string "#f64(1.0 -2 3e10) (a #f64(0.5))"))
(let ((x (read p)) (y (read p)))
  (check (f64vector->list x) '(1.0 -2.0 3e10))
  (check (f64vector? (cadr y)) #t))
(define (dot a b)
  (let loop ((i 0) (s 0.0))
    (if (< i (f64vector-length a))
        (loop (+ i 1) (+ s (* (f64vector-ref a i) (f64vector-ref b i))))
        s)))
(define n 1000)
(define a (make-f64vector n 0.0))
(define b (make-f64vector n 0.0))
(do ((i 0 (+ i 1))) ((= i n)) (f64vector-set! a i (inexact i)) (f64vector-set! b i 0.5))
(check (dot a b) 249750.0)
(define big (make-f64vector 100000 1.0)) ; a large object (collector: raw, never scanned)
(check (f64vector-ref big 99999) 1.0)
(check-error "f64vector-ref" (f64vector-ref v 3))
(check-error "f64vector-ref" (f64vector-ref v -1))
(check-error "f64vector-ref" (f64vector-ref v 1.0))
(check-error "f64vector-ref" (f64vector-ref (vector 1.0) 0))
(check-error "f64vector-set!" (f64vector-set! v 0 'x))
(check-error "f64vector-set!" (f64vector-set! #f64(1.0) 0 2.0))
(check-error "f64vector-length" (f64vector-length "abc"))
(check-error "make-f64vector" (make-f64vector -1))
(check-error "list->f64vector" (list->f64vector '(1 a)))
(check-done)
