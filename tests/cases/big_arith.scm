;; --bignum: exact integer arithmetic at scale (expected output: tests/cases/inc/bignum_ref.py, Python's
;; integers): factorials, Fibonacci 1000, power ladders across 2^62, quotient/remainder/modulo/floor
;; with every sign combination and their reconstruction, (a*b)/b = a, gcd/lcm, exact-integer-sqrt of
;; squares and their neighbours, normalisation back to fixnums at +-2^62, predicates, and the errors
;; of operations that need a machine-size integer when given a bignum.
(import (scheme base) (scheme write))
(define (show . xs) (for-each (lambda (x) (write x) (display " ")) xs) (newline))
(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))
(define (fib n) (let loop ((a 0) (b 1) (i 0)) (if (= i n) a (loop b (+ a b) (+ i 1)))))
(define M 2305843009213693951)
(define hi 4611686018427387903)
(define lo -4611686018427387904)
(for-each (lambda (n) (show 'fact n (fact n))) '(20 21 25 50 100))
(let ((f (fact 1000)))
  (show 'fact1000 (string-length (number->string f)) (modulo f 1000000007) (modulo f M))
  (show 'fact1000/fact998 (quotient f (fact 998))))
(show 'fib 1000 (fib 1000))
(do ((n 58 (+ n 1))) ((> n 66))
  (let ((p (expt 2 n)))
    (show 'pow2 n p (- p) (- p 1) (+ (- p) 1) (* p p))))
(show 'pow3 (expt 3 200))
(let ((t (expt 3 10000)))
  (show 'pow3-10000 (string-length (number->string t)) (modulo t M)))
(define A (list 0 1 -1 7 -7 hi lo (+ hi 1) (- lo 1) (+ (expt 2 64) 5) (- (- (expt 2 64)) 5)
                (+ (expt 10 30) 7) (- (- (expt 10 30)) 7) (expt 3 100) (- (expt 3 100)) (- (expt 2 200) 1)))
(define B (list 1 -1 3 -3 1000000007 -1000000007 hi lo (expt 2 64) (- (expt 2 64))
                (+ (expt 10 20) 9) (- (- (expt 10 20)) 9) (expt 3 60)))
(for-each
 (lambda (x)
   (for-each
    (lambda (y)
      (let ((q (quotient x y)) (r (remainder x y)))
        (show 'qr x y q r (modulo x y) (floor-quotient x y) (= (+ (* y q) r) x) (= (quotient (* x y) y) x))
        (call-with-values (lambda () (floor/ x y))
          (lambda (fq fr) (if (not (and (= fq (floor-quotient x y)) (= fr (floor-remainder x y)) (= fr (modulo x y)))) (show 'floor/-mismatch x y))))
        (call-with-values (lambda () (truncate/ x y))
          (lambda (tq tr) (if (not (and (= tq q) (= tr r) (= tq (truncate-quotient x y)) (= tr (truncate-remainder x y)))) (show 'truncate/-mismatch x y))))))
    B))
 A)
(for-each (lambda (p) (show 'gcd-lcm (gcd (car p) (cdr p)) (lcm (car p) (cdr p))))
          (list (cons (expt 2 100) (* (expt 2 80) 3)) (cons (fact 30) (* (fact 25) 7)) (cons 0 (expt 2 70))
                (cons (- (expt 2 90)) (expt 6 40)) (cons (expt 10 40) (+ (expt 10 41) 1))))
(for-each
 (lambda (k)
   (for-each (lambda (j) (call-with-values (lambda () (exact-integer-sqrt j)) (lambda (s r) (show 'isqrt j s r))))
             (list (- (* k k) 1) (* k k) (+ (* k k) 1))))
 (list (expt 2 62) (expt 2 64) (expt 10 30) (expt 3 101) (+ (expt 2 199) 12345)))
(let ((big (+ hi 1)) (nbig (- lo 1)))
  (show 'bound big nbig (eq? (- big 1) hi) (eq? (+ nbig 1) lo) (eq? (- (* 2 big) big big) 0) (eq? (quotient (* big 4) 8) (quotient big 2))))
(show 'neg (- lo) (abs lo) (eq? (- (- lo)) lo))
(show 'square (square (+ (expt 2 40) 3)) (square (- (expt 2 70))))
(let ((x (expt 2 100)) (y (* (expt 2 50) (expt 2 50))))
  (show 'eqv (eqv? x y) (equal? (list x 1) (list y 1)) (eq? x 1) (= x y) (equal? (vector x) (vector y))))
(show 'zero (zero? (expt 2 70)) (zero? (- (expt 2 70) (expt 2 70))) (positive? (- (expt 2 70))) (negative? (- (expt 2 70)))
      (positive? (expt 2 70)) (negative? (expt 2 70)))
(show 'odd-even (odd? (+ (expt 2 70) 1)) (even? (+ (expt 2 70) 1)) (odd? (expt 2 70)) (even? (- (expt 2 70))))
(show 'maxmin (max 1 (expt 2 100) -5) (min 1 (- (expt 2 100)) 5) (exact? (max (expt 2 100) 3)))
(show 'expt (expt -3 41) (expt (expt 2 70) 3) (expt (expt 2 70) 0) (expt 1 (expt 2 100)) (expt -1 (+ (expt 2 100) 1))
      (expt 0 (expt 2 100)) (expt -1 (expt 2 100)))
(show 'exact-integer? (exact-integer? (expt 2 70)) (exact? (expt 2 70)) (integer? (expt 2 70)) (rational? (expt 2 70))
      (real? (expt 2 70)) (number? (expt 2 70)) (inexact? (expt 2 70)))
(let ((x (expt 2 100)))
  (show 'rounding (floor x) (ceiling (- x)) (round x) (truncate x) (exact x)))
(show 'numden (numerator (expt 2 100)) (denominator (expt 2 100)))
(define-syntax err
  (syntax-rules () ((_ e) (show 'error (guard (x ((error-object? x) (error-object-message x))) e 'no-error)))))
(define big (expt 2 64))
(err (vector-ref (vector 1 2 3) big))
(err (string-ref "abc" big))
(err (make-vector big 0))
(err (integer->char big))
(err (list-tail '(1 2 3) big))
(err (expt 2 big))
(err (exact-integer-sqrt (- big)))
(err (bytevector-u8-ref (bytevector 1 2) big))
(err (make-string big #\a))
