;; --bignum: a randomized differential corpus of 4,000 operations on operands of 1 to 3,000 bits (and
;; values next to 2^62), both signs, from a Park-Miller generator that tests/cases/inc/bignum_ref.py
;; reproduces with Python's integers: + - * quotient remainder modulo floor-quotient gcd lcm < >
;; identities (eqv?/equal?/=), expt, exact-integer-sqrt, exact and inexact /, inexact, comparison with
;; a flonum, radix 16 and 10 round trips. Each line is the operation's index and a digest of its
;; result: modulo 2^61-1 for exact integers, (exact (floor (* d 1e6))) modulo 2^61-1 for flonums.
(import (scheme base) (scheme write) (scheme inexact))
(define M 2305843009213693951)
(define seed 12345)
(define (rnd) (set! seed (modulo (* seed 48271) 2147483647)) seed)
(define (rbits k)
  (let loop ((r 0) (b 0))
    (if (< b k) (loop (+ (* r 2147483648) (rnd)) (+ b 31)) (quotient r (expt 2 (- b k))))))
(define (operand)
  (let* ((c (modulo (rnd) 100))
         (v (if (< c 8)
                (+ (expt 2 62) (modulo (rnd) 5) -2)
                (rbits (+ 1 (modulo (rnd) (cond ((< c 30) 64) ((< c 65) 256) ((< c 92) 1024) (else 3000))))))))
    (if (= (modulo (rnd) 2) 1) (- v) v)))
(define (d x) (modulo x M))
(define (fdig x) (cond ((infinite? x) (if (> x 0) '+inf '-inf))
                       ((infinite? (* x 1e6)) (if (> x 0) '+inf '-inf))
                       (else (d (exact (floor (* x 1e6)))))))
(define (out i . xs) (write i) (for-each (lambda (x) (display " ") (write x)) xs) (newline))
(do ((i 0 (+ i 1))) ((= i 4000))
  (let* ((a (operand)) (b (let ((b (operand))) (if (= b 0) 1 b))))
    (case (modulo i 18)
      ((0) (out i (d (+ a b))))
      ((1) (out i (d (- a b))))
      ((2) (out i (d (* a b))))
      ((3) (out i (d (quotient a b))))
      ((4) (out i (d (remainder a b))))
      ((5) (out i (d (modulo a b))))
      ((6) (out i (d (floor-quotient a b))))
      ((7) (out i (d (gcd a b))))
      ((8) (out i (d (lcm a b))))
      ((9) (out i (< a b) (> a b)))
      ((10) (out i (= a (- (+ a b) b)) (eqv? (- (+ a b) b) a) (equal? (list a) (list (* (+ a 0) 1)))))
      ((11) (let* ((e (modulo (rnd) 7))
                   (base (if (>= a 0) (modulo a (expt 2 300)) (- (modulo (- a) (expt 2 300))))))
              (out i (d (expt base e)))))
      ((12) (call-with-values (lambda () (exact-integer-sqrt (abs a))) (lambda (s r) (out i (d s) (d r)))))
      ((13) (let ((q (/ a b))) (out i (if (exact? q) (d q) (fdig q)))))
      ((14) (out i (fdig (inexact a))))
      ((15) (out i (< a (inexact b)) (= a (inexact a))))
      ((16) (let ((s (number->string a 16))) (out i (string-length s) (= (string->number s 16) a))))
      (else (let ((s (number->string a))) (out i (string-length s) (= (string->number s) a)))))))
