;; Collector: churn of strings, vectors (small and medium), closures, flonums,
;; bytevectors, records and boxes (captured, assigned variables); 100 live entries of
;; each kind are kept in rings and verified against freshly computed values at the end.
(import (scheme base) (scheme write))
(define (show x) (write x) (newline))
(define-record-type point (make-point x y) point? (x point-x) (y point-y set-point-y!))
(define n 300000)
(define size 100)
(define strings (make-vector size #f))
(define vectors (make-vector size #f))
(define mediums (make-vector size #f))
(define closures (make-vector size #f))
(define flonums (make-vector size #f))
(define bytes (make-vector size #f))
(define points (make-vector size #f))
(define counters (make-vector size #f))
(define (make-string-for i) (string-append "s" (number->string i) "-" (make-string (modulo i 7) #\x)))
(define (make-counter start)          ; a boxed variable: captured and assigned
  (let ((c start)) (lambda () (set! c (+ c 1)) c)))
(define (fill-bytes i) (let ((b (make-bytevector 16 0)))
                         (do ((k 0 (+ k 1))) ((= k 16) b) (bytevector-u8-set! b k (modulo (+ i k) 256)))))
(let loop ((i 0))
  (when (< i n)
    (let ((k (modulo i size)))
      (vector-set! strings k (make-string-for i))
      (vector-set! vectors k (vector i (* 2 i) (list i)))
      (vector-set! mediums k (make-vector 60 i))      ; 488 bytes: a medium object
      (vector-set! closures k (let ((a i) (b (list i i))) (lambda (x) (+ x a (car b)))))
      (vector-set! flonums k (list (+ 0.5 i) (* 1.5 i)))
      (vector-set! bytes k (fill-bytes i))
      (vector-set! points k (make-point i (make-point (- i) (string #\p))))
      (vector-set! counters k (make-counter i))
      ((vector-ref counters k))
      (set-point-y! (point-y (vector-ref points k)) (number->string i 16))
      (loop (+ i 1)))))
(define (ok-at? k)
  (let ((i (+ (- n size) k)))
    (and (equal? (vector-ref strings k) (make-string-for i))
         (equal? (vector-ref vectors k) (vector i (* 2 i) (list i)))
         (equal? (vector-ref mediums k) (make-vector 60 i))
         (= ((vector-ref closures k) 1) (+ 1 i i))
         (equal? (vector-ref flonums k) (list (+ 0.5 i) (* 1.5 i)))
         (equal? (vector-ref bytes k) (fill-bytes i))
         (= (point-x (vector-ref points k)) i)
         (= (point-x (point-y (vector-ref points k))) (- i))
         (equal? (point-y (point-y (vector-ref points k))) (number->string i 16))
         (= ((vector-ref counters k)) (+ i 2)))))
(show (let loop ((k 0)) (cond ((= k size) 'all-ok) ((ok-at? k) (loop (+ k 1))) (else (list 'bad k)))))
(show (vector-ref strings 7))
(show (vector-ref flonums 3))
