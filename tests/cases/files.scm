;; (scheme file): textual and binary round trips, the call-with-* and with-* procedures,
;; file-exists?, delete-file, and file errors (file-error?). Files go to tests/tmp.
(import (scheme base) (scheme file) (scheme read) (scheme write) (util check))

(define txt "tests/tmp/files-case.txt")
(define bin "tests/tmp/files-case.bin")
(define (file-error-of thunk) (guard (e ((file-error? e) 'file-error) (#t (list 'other e))) (thunk) 'no-error))
(when (file-exists? txt) (delete-file txt))
(check (file-exists? txt) #f)
(call-with-output-file txt
  (lambda (p) (write '(hello "wörld" #\λ 1.5) p) (newline p) (write-string "second line" p)))
(check (file-exists? txt) #t)
(check (call-with-input-file txt read) '(hello "wörld" #\λ 1.5))
(check (call-with-input-file txt (lambda (p) (read-line p) (read-line p))) "second line")
(check (call-with-input-file txt (lambda (p) (read-line p) (read-line p) (eof-object? (read-line p)))) #t)
;; with-output-to-file / with-input-from-file rebind the current ports and close the file
(with-output-to-file txt (lambda () (display "via current-output-port") (newline) (write 'sym)))
(check (with-input-from-file txt (lambda () (list (read-line) (read)))) '("via current-output-port" sym))
(check (let ((p (open-input-file txt))) (let ((c (read-char p))) (close-port p) c)) #\v)
(check (call-with-values (lambda () (call-with-input-file txt (lambda (p) (values 1 2)))) list) '(1 2))
;; binary
(define bytes (let ((bv (make-bytevector 1000))) (do ((i 0 (+ i 1))) ((= i 1000) bv) (bytevector-u8-set! bv i (modulo (* i 7) 256)))))
(let ((p (open-binary-output-file bin)))
  (write-bytevector bytes p)
  (write-u8 255 p)
  (close-port p))
(let ((p (open-binary-input-file bin)))
  (check (binary-port? p) #t)
  (check (equal? (read-bytevector 1000 p) bytes) #t)
  (check (read-u8 p) 255)
  (check (eof-object? (read-u8 p)) #t)
  (close-port p))
(check (textual-port? (open-binary-input-file bin)) #f)
(check (guard (e ((file-error? e) 'file-error) (#t (error-object-message e))) (read-char (open-binary-input-file bin)))
       "read-char: expected textual input port")
;; errors
(check (file-error-of (lambda () (open-input-file "tests/tmp/no/such/file"))) 'file-error)
(check (file-error-of (lambda () (open-binary-input-file "tests/tmp/no/such/file"))) 'file-error)
(check (file-error-of (lambda () (open-output-file "tests/tmp/no/such/dir/file"))) 'file-error)
(check (file-error-of (lambda () (call-with-input-file "tests/tmp/no/such/file" read))) 'file-error)
(check (file-error-of (lambda () (delete-file "tests/tmp/no/such/file"))) 'file-error)
(check (guard (e (#t (error-object-message e))) (open-input-file "tests/tmp/nonexistent")) "open-input-file: cannot open file")
(delete-file txt)
(delete-file bin)
(check (list (file-exists? txt) (file-exists? bin) (file-exists? "tests")) '(#f #f #t))
(check-done)
