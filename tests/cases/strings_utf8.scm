;; UTF-8 strings (spec 3.2): indexing and mutation of non-ASCII strings, where a character's
;; encoded width changes (variable-width replacement), and the ASCII fast path.
(import (scheme base) (util check))

(define s (string #\a #\λ #\c #\x1F600 #\e))
(check (string-length s) 5)
(check (map (lambda (i) (string-ref s i)) '(0 1 2 3 4)) '(#\a #\λ #\c #\x1F600 #\e))
(check (string->utf8 s) #u8(97 206 187 99 240 159 152 128 101))
;; width changes: 1 -> 2, 2 -> 1, 4 -> 3, 1 -> 4
(string-set! s 0 #\μ)
(check s "μλc\x1F600;e")
(string-set! s 1 #\b)
(check s "μbc\x1F600;e")
(string-set! s 3 #\€)
(check s "μbc€e")
(string-set! s 4 #\x10FFFF)
(check (string-ref s 4) #\x10FFFF)
(check (string-length s) 5)
(check (bytevector-length (string->utf8 s)) 11)
;; back to ASCII: the fast path must work again afterwards
(for-each (lambda (i) (string-set! s i #\x)) '(0 1 2 3 4))
(check s "xxxxx")
(check (bytevector-length (string->utf8 s)) 5)
(string-set! s 2 #\y)
(check s "xxyxx")
;; substring, string-copy, string->list etc. with character (not byte) indices
(define t "añb€c😀d")
(check (substring t 1 4) "ñb€")
(check (string-copy t 5) "😀d")
(check (string->list t 3 6) '(#\€ #\c #\x1F600))
(check (string->vector t 6) #(#\d))
(check (string->utf8 t 3 4) #u8(226 130 172))
(check (utf8->string (string->utf8 t) 1 3) "ñ")
;; string-copy! between strings of different widths, both directions, overlapping
(define u (make-string 6 #\-))
(string-copy! u 1 t 1 4)
(check u "-ñb€--")
(string-copy! u 4 "😀😀")
(check u "-ñb€😀😀")
(string-copy! u 0 "abc")
(check u "abc€😀😀")
(define v (string-copy "aλbμc€"))
(string-copy! v 0 v 1 5)
(check v "λbμcc€")
(define w (string-copy "aλbμc€"))
(string-copy! w 2 w 0 4)
(check w "aλaλbμ")
;; string-fill! changing widths
(define f (string-copy "abcdef"))
(string-fill! f #\λ 1 3)
(check f "aλλdef")
(string-fill! f #\z 2)
(check f "aλzzzz")
(string-fill! f #\x1F600)
(check f "😀😀😀😀😀😀")
(check (string-length f) 6)
;; comparison is code point order
(check (string<? "z" "λ" "€" "😀") #t)
(check (string=? "λ" (string #\λ)) #t)
(check (string-append "λ" "" "€") "λ€")
;; string-map / string-for-each over non-ASCII, several strings
(check (string-map (lambda (c) (if (char=? c #\λ) #\L c)) "aλbλ") "aLbL")
(check (string-map (lambda (a b) (if (char<? a b) b a)) "aλ€" "bb") "bλ")
(check (let ((n 0)) (string-for-each (lambda (c d) (set! n (+ n (char->integer c) (char->integer d)))) "λ€" "ab😀") n)
       (+ 955 8364 97 98))
;; errors
(check-error "string-ref" (string-ref t 7))
(check-error "string-set!" (string-set! (string-copy t) -1 #\a))
(check-error "string-set!" (string-set! "literal" 0 #\a))
(check-error "string-copy!" (string-copy! (make-string 2) 1 "λμ"))
(check-error "string-fill!" (string-fill! (make-string 2) #\a 0 3))
(check-error "string-set!" (string-set! (make-string 2) 0 "a"))
(check-done)
