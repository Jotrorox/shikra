;; Coverage of the M0 standard library: every exported procedure of (scheme base),
;; (scheme write), (scheme cxr) and (scheme process-context) at least once.
(import (scheme base) (scheme write) (scheme cxr) (scheme case-lambda) (scheme process-context))
(define (show . xs) (for-each (lambda (x) (write x) (write-char #\space)) xs) (newline))
;; numbers
(show (+) (+ 1) (+ 1 2 3 4) (- 5) (- 10 1 2) (* 2 3 4) (/ 1 4) (/ 6 3) (/ 2))
(show (= 1 1 1) (< 1 2 3) (< 1 3 2) (> 3 2 1) (<= 1 1 2) (>= 2 2 1) (= 1 1.0))
(show (max 1 2 3) (max 1 2.0) (min 3 1 2) (abs -5) (abs 5.5) (zero? 0) (positive? 1) (negative? -1) (odd? 3) (even? 3))
(show (quotient 17 5) (remainder -17 5) (modulo -17 5) (floor-quotient -17 5) (floor-remainder -17 5)
      (truncate-quotient -17 5) (truncate-remainder -17 5) (gcd 12 18) (lcm 4 6) (gcd) (lcm))
(call-with-values (lambda () (floor/ -7 2)) (lambda (q r) (show 'floor/ q r)))
(call-with-values (lambda () (truncate/ -7 2)) (lambda (q r) (show 'truncate/ q r)))
(call-with-values (lambda () (exact-integer-sqrt 17)) (lambda (s r) (show 'sqrt s r)))
(show (floor 2.5) (ceiling 2.5) (round 2.5) (round 3.5) (truncate -2.7) (exact 2.0) (inexact 1) (square 5))
(show (number? 1) (complex? 1.5) (real? 'a) (rational? 1.5) (integer? 2.0) (exact? 1) (inexact? 1.0) (exact-integer? 5))
(show (number->string 255) (number->string 255 16) (string->number "42") (string->number "ff" 16) (string->number "x"))
;; booleans, equivalence, symbols
(show (not #f) (not 3) (boolean? #f) (boolean=? #t #t) (boolean=? #t #f #t) (eq? 'a 'a) (eqv? 1.5 1.5) (equal? '(1 #(2)) '(1 #(2))))
(show (symbol? 'x) (symbol->string 'abc) (string->symbol "q") (symbol=? 'a 'a 'a) (eq? (string->symbol "hello") 'hello))
;; lists
(define l (list 1 2 3 4 5))
(show (cons 1 2) (car l) (cdr l) (pair? l) (null? '()) (list? l) (list? '(1 . 2)) (length l) (append) (append '(1) '(2) '(3 4) 5))
(show (reverse l) (list-tail l 2) (list-ref l 3) (list-copy '(1 2 . 3)) (make-list 3 'x) (memq 'c '(a b c d)) (memv 2 '(1 2 3)) (member "b" '("a" "b")))
(show (member 2.0 '(1 2 3) =) (assq 'b '((a 1) (b 2))) (assv 2 '((1 a) (2 b))) (assoc "x" '(("x" . 1))) (assoc 2.0 '((1 a) (2 b)) =))
(let ((m (list 1 2 3))) (set-car! m 'a) (set-cdr! (cddr m) '(4)) (list-set! m 1 'b) (show m))
(show (caar '((1) 2)) (cadr l) (cdar '((1 . 2))) (cddr l) (caddr l) (cdddr l) (cadddr l) (cddddr l))
(show (map (lambda (x) (* x x)) l) (map list '(1 2 3) '(a b)) (map + '(1 2) '(10 20) '(100 200)))
(for-each (lambda (a b) (display (+ a b))) '(1 2) '(10 20)) (newline)
;; chars and strings
(show (char? #\a) (char->integer #\A) (integer->char 97) (char=? #\a #\a #\a) (char<? #\a #\b #\c) (char>? #\b #\a) (char<=? #\a #\a) (char>=? #\b #\c))
(define s (make-string 3 #\x))
(string-set! s 1 #\y)
(show s (string #\a #\b) (string-length "hello") (string-ref "hello" 1) (substring "hello" 1 3) (string-append) (string-append "a" "b" "c"))
(show (string-copy "hello" 1) (string->list "abc") (string->list "abcd" 1 3) (list->string '(#\x #\y)) (string=? "a" "a" "a") (string<? "a" "b") (string>? "b" "a") (string<=? "a" "a") (string>=? "a" "b"))
(let ((t (make-string 5 #\-))) (string-copy! t 1 "abc") (string-fill! t #\* 4) (show t))
(show (string-map (lambda (c) (integer->char (- (char->integer c) 32))) "abc") (string->utf8 "hé") (utf8->string (bytevector 104 105)))
;; vectors and bytevectors
(define v (vector 1 2 3))
(vector-set! v 0 'a)
(show v (make-vector 2 0) (vector-length v) (vector-ref v 1) (vector->list v) (vector->list v 1) (list->vector '(1 2)) (vector-copy v 1) (vector-append #(1) #(2 3)))
(let ((w (make-vector 4 0))) (vector-fill! w 7 2) (vector-copy! w 0 #(a b)) (show w (vector->string #(#\a #\b)) (string->vector "xy")))
(show (vector-map (lambda (x) (* x 10)) #(1 2)) (bytevector 1 2 3) (make-bytevector 2 255) (bytevector-u8-ref #u8(5 6) 1) (bytevector-length #u8(1 2 3)))
(let ((b (make-bytevector 4 0))) (bytevector-u8-set! b 0 9) (bytevector-copy! b 1 #u8(7 8)) (show b (bytevector-copy b 1 3) (bytevector-append #u8(1) #u8(2 3))))
(vector-for-each (lambda (x) (display x)) #(1 2 3)) (string-for-each (lambda (c) (display (char->integer c))) "AB") (newline)
;; control
(show (procedure? car) (procedure? 'car) (apply + 1 2 '(3 4)) (apply list '()) (call-with-values (lambda () (values 1 2 3)) list) (call-with-values (lambda () 5) list))
(show (values 7) (call-with-values values list))
;; errors
(show (error-object? 5) (file-error? 5) (read-error? 5))
;; io
(define op (open-output-string))
(write 'sym op) (write-char #\! op) (write-string "str" op) (newline op) (display 3.5 op)
(show (get-output-string op))
(define ip (open-input-string "ab\ncd"))
(show (peek-char ip) (read-char ip) (read-line ip) (read-string 5 ip) (eof-object? (read-char ip)) (eof-object? (eof-object)))
(show (port? ip) (input-port? ip) (output-port? op) (textual-port? op) (input-port? (current-input-port)) (output-port? (current-output-port)))
(write-string "hello" (current-output-port) 1 3) (newline)
(write-simple '(a "b")) (newline)
(flush-output-port)
(exit 0)
