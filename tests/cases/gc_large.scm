;; Collector: large objects (above 8 KB: separate mappings) and medium ones, churned
;; while the last few of each kind stay live; contents verified at the end.
(import (scheme base) (scheme write))
(define (show x) (write x) (newline))
(define keep 4)
(define vecs (make-vector keep #f))
(define bvs (make-vector keep #f))
(define strs (make-vector keep #f))
(define (vec-for i) (let ((v (make-vector 5000 i))) (vector-set! v 4999 (list i 'tail)) v))
(define (bv-for i) (make-bytevector 100000 (modulo i 256)))
(define (str-for i) (make-string 20000 (integer->char (+ 65 (modulo i 26)))))
(define rounds 3000)
(let loop ((i 0))
  (when (< i rounds)
    (let ((k (modulo i keep)))
      (vector-set! vecs k (vec-for i))
      (vector-set! bvs k (bv-for i))
      (vector-set! strs k (str-for i))
      (make-vector 700 i)                 ; garbage, medium-sized
      (loop (+ i 1)))))
(define (ok? k)
  (let ((i (+ (- rounds keep) k)))
    (and (equal? (vector-ref vecs k) (vec-for i))
         (equal? (vector-ref bvs k) (bv-for i))
         (string=? (vector-ref strs k) (str-for i)))))
(show (let loop ((k 0)) (cond ((= k keep) 'large-ok) ((ok? k) (loop (+ k 1))) (else (list 'bad k)))))
(show (list (vector-ref (vector-ref vecs 1) 4999) (bytevector-u8-ref (vector-ref bvs 2) 99999)
            (string-ref (vector-ref strs 3) 19999)))
