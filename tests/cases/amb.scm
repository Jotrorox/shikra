;; Backtracking with amb on re-entrant call/cc (tier 3, spec §8.2): the fail stack holds
;; continuations captured inside earlier choices; failing re-enters the latest one.
(import (scheme base) (scheme write))

(define fail-stack '())
(define (fail)
  (if (null? fail-stack)
      (error "no more choices")
      (let ((back (car fail-stack)))
        (set! fail-stack (cdr fail-stack))
        (back back))))
(define (amb choices)
  (let ((cc (call/cc (lambda (k) k))))
    (if (null? choices)
        (fail)
        (let ((choice (car choices)))
          (set! choices (cdr choices))
          (set! fail-stack (cons cc fail-stack))
          choice))))
(define (require p) (if (not p) (fail)))
(define (distinct? l)
  (cond ((null? l) #t) ((memv (car l) (cdr l)) #f) (else (distinct? (cdr l)))))

;; SICP 4.3.2: the multiple-dwelling puzzle
(define (multiple-dwelling)
  (let* ((baker (amb '(1 2 3 4 5)))
         (cooper (amb '(1 2 3 4 5)))
         (fletcher (amb '(1 2 3 4 5)))
         (miller (amb '(1 2 3 4 5)))
         (smith (amb '(1 2 3 4 5))))
    (require (distinct? (list baker cooper fletcher miller smith)))
    (require (not (= baker 5)))
    (require (not (= cooper 1)))
    (require (not (= fletcher 5)))
    (require (not (= fletcher 1)))
    (require (> miller cooper))
    (require (not (= (abs (- smith fletcher)) 1)))
    (require (not (= (abs (- fletcher cooper)) 1)))
    (list (list 'baker baker) (list 'cooper cooper) (list 'fletcher fletcher)
          (list 'miller miller) (list 'smith smith))))
(write (multiple-dwelling))
(newline)

;; every Pythagorean triple with sides up to 20, collected by failing after each solution
(define triples '())
(define (int-between lo hi) (if (> lo hi) (amb '()) (amb (iota (+ (- hi lo) 1) lo))))
(define (iota n start) (if (= n 0) '() (cons start (iota (- n 1) (+ start 1)))))
(call/cc
 (lambda (done)
   (set! fail-stack (list (lambda (ignore) (done #f))))
   (let* ((a (int-between 1 20))
          (b (int-between a 20))
          (c (int-between b 20)))
     (require (= (* c c) (+ (* a a) (* b b))))
     (set! triples (cons (list a b c) triples))
     (fail))))
(write (reverse triples))
(newline)

;; eight queens: the first solution, and how many there are
(define (queens n)
  (let loop ((row 0) (placed '()))
    (if (= row n)
        (reverse placed)
        (let ((col (int-between 0 (- n 1))))
          (let check ((p placed) (d 1))
            (unless (null? p)
              (require (not (= (car p) col)))
              (require (not (= (abs (- (car p) col)) d)))
              (check (cdr p) (+ d 1))))
          (loop (+ row 1) (cons col placed))))))
(define solutions 0)
(call/cc
 (lambda (done)
   (set! fail-stack (list (lambda (ignore) (done #f))))
   (let ((q (queens 8)))
     (if (= solutions 0) (begin (write q) (newline)))
     (set! solutions (+ solutions 1))
     (fail))))
(write solutions)
(newline)
