;; (shikra fixnum) against independently computed results (tests/cases/inc/fixnum_ref.py wrote
;; ext_fixnum_ref.out with Python's unbounded integers): arithmetic, overflow, bitwise operations,
;; shifts by 0..62 and negative counts, bit fields, the carry operations, at the boundary values.
(import (scheme base) (scheme write) (scheme char) (shikra fixnum))
(define hi fx-greatest)
(define lo fx-least)
(define V (list 0 1 -1 2 -2 3 5 7 255 -256 12345678901 -98765432109 hi lo (- hi 1) (+ lo 1)
                2147483648 -2147483648 2305843009213693952 -2305843009213693952))
(define C '(0 1 5 31 61 62 -1 -62))
(define S (list 0 1 -1 7 hi lo 1099511627776 -1099511627776))
(define (contains? s sub)
  (let ((n (string-length s)) (m (string-length sub)))
    (let loop ((i 0)) (cond ((> (+ i m) n) #f) ((string=? (substring s i (+ i m)) sub) #t) (else (loop (+ i 1)))))))
(define-syntax try
  (syntax-rules ()
    ((_ e) (guard (x ((error-object? x) (if (contains? (error-object-message x) "overflow") 'overflow 'error))) e))))
(define (show-r r)
  (cond ((eq? r #t) (display "#t")) ((eq? r #f) (display "#f")) (else (display r))))
(define (line op args r)
  (display op)
  (for-each (lambda (a) (display " ") (show-r a)) args)
  (display " => ")
  (show-r r)
  (newline))
(define (line2 op args thunk)
  (display op)
  (for-each (lambda (a) (display " ") (show-r a)) args)
  (display " => ")
  (call-with-values thunk (lambda (r q) (display r) (display " ") (display q)))
  (newline))
(for-each
 (lambda (a)
   (for-each
    (lambda (b)
      (line "fx+" (list a b) (try (fx+ a b)))
      (line "fx-" (list a b) (try (fx- a b)))
      (line "fx*" (list a b) (try (fx* a b)))
      (line "fxand" (list a b) (fxand a b))
      (line "fxior" (list a b) (fxior a b))
      (line "fxxor" (list a b) (fxxor a b))
      (line "fxquotient" (list a b) (try (fxquotient a b)))
      (line "fxremainder" (list a b) (try (fxremainder a b)))
      (line "fx<?" (list a b) (fx<? a b)))
    V)
   (line "fxneg" (list a) (try (fxneg a)))
   (line "fxabs" (list a) (try (fxabs a)))
   (line "fxsquare" (list a) (try (fxsquare a)))
   (line "fxnot" (list a) (fxnot a))
   (line "fxbit-count" (list a) (fxbit-count a))
   (line "fxlength" (list a) (fxlength a))
   (line "fxfirst-set-bit" (list a) (fxfirst-set-bit a))
   (for-each
    (lambda (n)
      (line "fxarithmetic-shift" (list a n) (try (fxarithmetic-shift a n)))
      (when (>= n 0)
        (line "fxarithmetic-shift-right" (list a n) (fxarithmetic-shift-right a n))
        (line "fxarithmetic-shift-left" (list a n) (try (fxarithmetic-shift-left a n)))
        (line "fxbit-set?" (list n a) (fxbit-set? n a))
        (line "fxcopy-bit" (list n a #t) (fxcopy-bit n a #t))
        (line "fxcopy-bit" (list n a #f) (fxcopy-bit n a #f))))
    C)
   (for-each
    (lambda (se)
      (let ((s (car se)) (e (cadr se)))
        (line "fxbit-field" (list a s e) (fxbit-field a s e))
        (for-each (lambda (c) (line "fxbit-field-rotate" (list a c s e) (fxbit-field-rotate a c s e))) '(0 1 3 -2 70))
        (line "fxbit-field-reverse" (list a s e) (fxbit-field-reverse a s e))))
    '((0 0) (0 1) (0 8) (3 17) (0 62) (1 63) (40 63) (62 63) (10 10))))
 V)
(for-each
 (lambda (i)
   (for-each
    (lambda (j)
      (for-each
       (lambda (k)
         (line2 "fx+/carry" (list i j k) (lambda () (fx+/carry i j k)))
         (line2 "fx-/carry" (list i j k) (lambda () (fx-/carry i j k)))
         (line2 "fx*/carry" (list i j k) (lambda () (fx*/carry i j k))))
       S))
    S))
 S)
(for-each (lambda (m) (line "fxif" m (apply fxif m)))
          (list (list 0 5 9) (list -1 5 9) (list #xF0F0 #x1234 -1) (list lo hi lo) (list 12345 -1 0)))
