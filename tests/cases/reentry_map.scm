;; The classic re-entry into map (R7RS 6.10: "if a continuation captured during map is invoked
;; again, the earlier results are not mutated"): the second pass replaces the element at the
;; capture, the list returned by the first pass stays as it was. Also vector-map, string-map
;; and a user-written map, under both engines.
(import (scheme base) (scheme write))
(let ((k* #f) (n 0) (results '()))
  (let ((r (map (lambda (x) (call/cc (lambda (k) (when (= x 2) (set! k* k)) x))) '(1 2 3))))
    (set! results (cons r results))
    (set! n (+ n 1))
    (when (< n 3) (k* (* 10 n)))
    (write (reverse results))
    (newline)))
(let ((k* #f) (n 0) (results '()))
  (let ((r (vector-map (lambda (x) (call/cc (lambda (k) (when (= x 2) (set! k* k)) x))) #(1 2 3))))
    (set! results (cons r results))
    (set! n (+ n 1))
    (when (< n 3) (k* (* 10 n)))
    (write (reverse results))
    (newline)))
(let ((k* #f) (n 0) (results '()))
  (let ((r (string-map (lambda (c) (call/cc (lambda (k) (when (char=? c #\b) (set! k* k)) c))) "abc")))
    (set! results (cons r results))
    (set! n (+ n 1))
    (when (< n 3) (k* (if (= n 1) #\X #\Y)))
    (write (reverse results))
    (newline)))
(define (my-map f l) (if (null? l) '() (let ((a (f (car l)))) (cons a (my-map f (cdr l))))))
(let ((k* #f) (n 0) (results '()))
  (let ((r (my-map (lambda (x) (call/cc (lambda (k) (when (= x 2) (set! k* k)) x))) '(1 2 3))))
    (set! results (cons r results))
    (set! n (+ n 1))
    (when (< n 3) (k* (* 10 n)))
    (write (reverse results))
    (newline)))
