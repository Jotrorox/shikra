;; Numeric tower edges (spec 3.2): 63-bit fixnums whose overflow raises a catchable error
;; naming the procedure, exact/inexact contagion, exact-integer-sqrt, expt, the flonum
;; printer on integer-valued and special values, and exact fixnum/flonum comparison.
(import (scheme base) (scheme write) (util check))

(define big 4611686018427387903)     ; (- (expt 2 62) 1), the largest fixnum
(define small -4611686018427387904)  ; the smallest, readable as a literal
(check (+ big small) -1)
(check-error "+" (+ big 1))
(check-error "+" (+ 1 2 big))
(check-error "-" (- small 1))
(check-error "-" (- small))
(check-error "*" (* big 2))
(check-error "*" (* small -1))
(check-error "abs" (abs small))
(check-error "quotient" (quotient small -1))
(check-error "/" (/ small -1))
(check-error "expt" (expt 2 62))
(check-error "expt" (expt -3 40))
(check-error "expt" (expt 0 -1))
(check-error "exact" (exact 4611686018427387904.0))
(check-error "exact" (exact 1.5))
(check-error "exact" (exact +nan.0))
(check-error "exact" (exact -inf.0))
(check (exact -4611686018427387904.0) small)
(check (expt -2 61) -2305843009213693952)
(check (expt 2 61) 2305843009213693952)
(check (expt 7 0) 1)
(check (expt 0 0) 1)
(check (expt 2 -3) 0.125)
(check (expt -1 -5) -1)
(check (expt 2.0 3) 8.0)
(check (expt 4 0.5) 2.0)
(check (abs -7.5) 7.5)
(check (abs -0.0) 0.0)
(check (- 0.0) -0.0)
(check (- 5) -5)
(check (remainder small -1) 0)
(check (modulo small -1) 0)
;; exact-integer-sqrt
(check (call-with-values (lambda () (exact-integer-sqrt 0)) list) '(0 0))
(check (call-with-values (lambda () (exact-integer-sqrt 1)) list) '(1 0))
(check (call-with-values (lambda () (exact-integer-sqrt 15)) list) '(3 6))
(check (call-with-values (lambda () (exact-integer-sqrt big)) list) '(2147483647 4294967294))
(check-error "exact-integer-sqrt" (exact-integer-sqrt -4))
(check-error "exact-integer-sqrt" (exact-integer-sqrt 4.0))
;; division: exact when it divides, else a flonum
(check (/ 6 3) 2)
(check (/ 6 4) 1.5)
(check (/ 1 -4) -0.25)
(check (/ 12 2 3) 2)
(check-error "/" (/ 1 0))
(check (/ 1.0 0) +inf.0)
(check (/ -1 0.0) -inf.0)
;; contagion and comparison
(check (max 1 2.0) 2.0)
(check (min 1 2.0) 1.0)
(check (+ 1/2 1) 1.5)
(check (= 9007199254740992.0 9007199254740993) #f)
(check (< 9007199254740992.0 9007199254740993) #t)
(check (> 9007199254740993 9007199254740992.0) #t)
(check (= big 4611686018427387904.0) #f)
(check (< big 4611686018427387904.0) #t)
(check (= small -4611686018427387904.0) #t)
(check (< 1 +inf.0) #t)
(check (> 1 -inf.0) #t)
(check (= +nan.0 +nan.0) #f)
(check (< 1 +nan.0) #f)
(check (exact (floor 2.7)) 2)
(check (round 2.5) 2.0)
(check (round -3.5) -4.0)
(check (truncate -2.7) -2.0)
(check (numerator 6.25) 25.0)
(check (denominator 6.25) 4.0)
(check (rationalize 0.3 0.1) (/ 1 3))
(check (rationalize 5 2) 3)
(check (gcd 0 0) 0)
(check (lcm 0 5) 0)
(check (lcm 6 -4) 12)
;; the flonum printer
(define (str x) (let ((p (open-output-string))) (write x p) (get-output-string p)))
(check (map str (list 1.0 -1.0 100.0 1e20 1e21 1.5e22 -0.0 0.0 +inf.0 -inf.0 +nan.0))
       '("1.0" "-1.0" "100.0" "100000000000000000000.0" "1e21" "1.5e22" "-0.0" "0.0" "+inf.0" "-inf.0" "+nan.0"))
(check (map str (list 0.5 0.1 123.456 1e-7 1.5e-10 4503599627370496.0 9007199254740993.0))
       '("0.5" "0.1" "123.456" "0.0000001" "1.5e-10" "4503599627370496.0" "9007199254740992.0"))
(check (number->string 2.0) "2.0")
(check (number->string small) "-4611686018427387904")
(check (number->string big 16) "3fffffffffffffff")
(check (number->string small 2) (string-append "-1" (make-string 62 #\0)))
(check (inexact big) 4611686018427387904.0)
(check-done)
