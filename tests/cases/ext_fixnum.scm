;; (shikra fixnum): variadic forms, predicates, fxsqrt, and the errors (wrong types and overflow
;; raise catchable errors naming the procedure; overflow never wraps). Bit-level results against
;; an independent reference: ext_fixnum_ref.scm.
(import (scheme base) (scheme write) (shikra fixnum) (util check))
(check (list fx-width fx-greatest fx-least) '(63 4611686018427387903 -4611686018427387904))
(check (map fixnum? (list 0 -5 fx-greatest 1.0 'a "1")) '(#t #t #t #f #f #f))
(check (list (fx=? 1 1 1) (fx<? 1 2 3) (fx<? 1 3 2) (fx>? 3 2 1) (fx<=? 1 1 2) (fx>=? 2 2 3) (fx=? 4)) '(#t #t #f #t #t #f #t))
(check (list (fxzero? 0) (fxpositive? -1) (fxnegative? -1) (fxodd? -3) (fxeven? -4) (fxodd? 0)) '(#t #f #t #t #t #f))
(check (list (fxmax 1 5 3) (fxmin 4 -2 9) (fxmax 7) (fxand) (fxior) (fxxor) (fxand 12 10 8) (fxior 1 2 4) (fxxor 7 1 2)) '(5 -2 7 -1 0 0 8 7 4))
(check (call-with-values (lambda () (fxsqrt 17)) list) '(4 1))
(check (call-with-values (lambda () (fxsqrt fx-greatest)) list) '(2147483647 4294967294))
(check (call-with-values (lambda () (fxsqrt 0)) list) '(0 0))
(define (sum-to n) (let loop ((i 0) (acc 0)) (if (fx>? i n) acc (loop (fx+ i 1) (fx+ acc i)))))
(check (sum-to 100000) 5000050000)
(check-error "fx+" (fx+ fx-greatest 1))
(check-error "fx-" (fx- fx-least 1))
(check-error "fx*" (fx* 3037000500 3037000500))
(check-error "fxneg" (fxneg fx-least))
(check-error "fxabs" (fxabs fx-least))
(check-error "fxsquare" (fxsquare 2147483648))
(check-error "fxquotient" (fxquotient 1 0))
(check-error "fxquotient" (fxquotient fx-least -1))
(check-error "fxremainder" (fxremainder 1 0))
(check-error "fxarithmetic-shift-left" (fxarithmetic-shift-left 1 62))
(check-error "fxarithmetic-shift" (fxarithmetic-shift 1 63))
(check-error "fxarithmetic-shift-right" (fxarithmetic-shift-right 1 -1))
(check-error "fx+" (fx+ 1 1.5))
(check-error "fx+" (fx+ 'a 1))
(check-error "fx<?" (fx<? 1 2 "3"))
(check-error "fxand" (fxand 1 #\a))
(check-error "fxnot" (fxnot 2.0))
(check-error "fxbit-set?" (fxbit-set? 63 1))
(check-error "fxbit-field" (fxbit-field 1 5 3))
(check-error "fxcopy-bit" (fxcopy-bit 1 0 1))
(check-error "fxsqrt" (fxsqrt -1))
(check-error "fx*/carry" (fx*/carry 1 2 3.0))
(define (hide x) (vector-ref (vector x) 0))
(check-error "fx+" (fx+ (hide 1) (hide 2.0)))
(check (fx* (hide 3) (hide -7)) -21)
(check-done)
