;; String and bytevector ports (R7RS 6.13): round trips, binary reads at end of file, port
;; kinds and states, call-with-port, errors on the wrong kind of port or a closed port.
(import (scheme base) (util check))

;; bytevector round trip: every byte value, written with write-u8 and write-bytevector
(define all-bytes (let ((bv (make-bytevector 256 0)))
                    (do ((i 0 (+ i 1))) ((= i 256) bv) (bytevector-u8-set! bv i i))))
(define out (open-output-bytevector))
(do ((i 0 (+ i 1))) ((= i 128)) (write-u8 i out))
(write-bytevector all-bytes out 128)
(check (get-output-bytevector out) all-bytes)
(check (get-output-bytevector out) all-bytes)          ; getting does not reset
(write-bytevector all-bytes out 0 2)
(check (bytevector-length (get-output-bytevector out)) 258)
(define in (open-input-bytevector all-bytes))
(check (read-u8 in) 0)
(check (peek-u8 in) 1)
(check (read-bytevector 3 in) #u8(1 2 3))
(define buf (make-bytevector 300 7))
(check (read-bytevector! buf in 10) 252)
(check (bytevector-copy buf 9 13) #u8(7 4 5 6))
(check (bytevector-u8-ref buf 261) 255)
;; at end of file
(check (eof-object? (read-u8 in)) #t)
(check (eof-object? (peek-u8 in)) #t)
(check (eof-object? (read-bytevector 1 in)) #t)
(check (read-bytevector 0 in) #u8())
(check (eof-object? (read-bytevector! buf in)) #t)
(check (read-bytevector! buf in 5 5) 0)
(check (u8-ready? in) #t)
(check (eof-object? (read-u8 (open-input-bytevector #u8()))) #t)
(check (read-bytevector 10 (open-input-bytevector #u8(1 2))) #u8(1 2))
;; the source bytevector is copied when the port is opened
(define src (bytevector 1 2 3))
(define in2 (open-input-bytevector src))
(bytevector-u8-set! src 0 99)
(check (read-u8 in2) 1)
;; text through strings and bytevectors
(define text "λx€\n😀 line 2\n")
(define so (open-output-string))
(write-string text so)
(write-char #\x10FFFF so)
(check (get-output-string so) (string-append text (string #\x10FFFF)))
(define si (open-input-string (utf8->string (string->utf8 text))))
(check (list (read-char si) (peek-char si) (read-line si) (read-line si)) '(#\λ #\x "x€" "😀 line 2"))
(check (eof-object? (read-line si)) #t)
(check (eof-object? (read-char si)) #t)
(check (eof-object? (peek-char si)) #t)
(check (eof-object? (read-string 1 si)) #t)
(check (char-ready? si) #t)
(check (let ((p (open-output-string))) (write-string "λμνξ" p 1) (write-string "abc" p 0 1) (get-output-string p)) "μνξa")
;; kinds and states
(check (map textual-port? (list (open-input-string "") (open-output-string) (open-input-bytevector #u8()) (open-output-bytevector)))
       '(#t #t #f #f))
(check (map binary-port? (list (open-input-string "") (open-output-string) (open-input-bytevector #u8()) (open-output-bytevector)))
       '(#f #f #t #t))
(check (list (port? 5) (input-port? (open-output-bytevector)) (output-port? (open-output-bytevector))) '(#f #f #t))
(check (list (textual-port? (current-input-port)) (binary-port? (current-output-port))) '(#t #f))
(define cp (open-input-bytevector #u8(1 2)))
(check (call-with-port cp (lambda (p) (read-u8 p))) 1)
(check (input-port-open? cp) #f)
(check (call-with-values (lambda () (call-with-port (open-input-string "ab") (lambda (p) (values (read-char p) (read-char p))))) list)
       '(#\a #\b))
(define bo (open-output-bytevector))
(close-output-port bo)
(check (output-port-open? bo) #f)
(close-port bo)                                          ; closing twice is fine
(check (flush-output-port (open-output-bytevector)) (if #f #f))
;; errors
(check-error "read-u8" (read-u8 (open-input-string "a")))
(check-error "read-char" (read-char (open-input-bytevector #u8(65))))
(check-error "write-u8" (write-u8 1 (open-output-string)))
(check-error "write-u8" (write-u8 256 (open-output-bytevector)))
(check-error "write-char" (write-char #\a (open-output-bytevector)))
(check-error "write-bytevector" (write-bytevector #u8(1) (open-output-bytevector) 0 2))
(check-error "read-bytevector!" (read-bytevector! (make-bytevector 2) (open-input-bytevector #u8(1)) 1 3))
(check-error "get-output-bytevector" (get-output-bytevector (open-output-string)))
(check-error "get-output-string" (get-output-string (open-output-bytevector)))
(check-error "write-u8" (write-u8 1 bo))
(check-error "read-u8" (read-u8 cp))
(check-error "close-input-port" (close-input-port (open-output-string)))
(check-error "close-output-port" (close-output-port (open-input-string "")))
(check-error "input-port-open?" (input-port-open? (open-output-string)))
(check-error "flush-output-port" (flush-output-port (open-input-string "")))
(check-done)
