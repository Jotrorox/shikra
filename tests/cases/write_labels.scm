;; (scheme write) datum labels (R7RS 6.13.3) and equal? on circular data (R7RS 6.1):
;; write/display label cycles only, write-shared all shared pairs and vectors, write-simple
;; none; labels are numbered from 0 in order of first appearance.
(import (scheme base) (scheme write) (util check))

(define (w proc x) (let ((p (open-output-string))) (proc x p) (get-output-string p)))
(define c1 (list 1 2 3))
(set-cdr! (cddr c1) c1)
(define cv (vector 'a 'b))
(vector-set! cv 1 cv)
(define cc (list 'x))
(set-car! cc cc)
(define s (list 1 2))
(check (w write c1) "#0=(1 2 3 . #0#)")
(check (w display c1) "#0=(1 2 3 . #0#)")
(check (w write cv) "#0=#(a #0#)")
(check (w write cc) "#0=(#0#)")
(check (w write (list c1 c1)) "(#0=(1 2 3 . #0#) #0#)")
(check (w write (vector cc cv)) "#(#0=(#0#) #1=#(a #1#))")
(check (w write (list s s)) "((1 2) (1 2))")              ; shared but acyclic: no labels
(check (w write-shared (list s s)) "(#0=(1 2) #0#)")
(check (w write-simple (list s s)) "((1 2) (1 2))")
(check (w write-shared (let ((v (vector 1))) (list v (cons v v)))) "(#0=#(1) (#0# . #0#))")
(check (w write-shared c1) "#0=(1 2 3 . #0#)")
(check (w write-shared (cons s (cdr s))) "((1 . #0=(2)) . #0#)")
(check (w write '(a "b" #\c 1.5 #(1 (2)))) "(a \"b\" #\\c 1.5 #(1 (2)))")
(check (w display '(a "b" #\c)) "(a b c)")
(check (w write '()) "()")
(check (w write '#()) "#()")
;; a cycle through a vector inside a list, and through the car
(define m (list 1 (vector 2 #f)))
(vector-set! (cadr m) 1 m)
(check (w write m) "#0=(1 #(2 #0#))")
;; a long acyclic list prints without labels (the pre-pass is iterative)
(define long (let loop ((i 0) (acc '())) (if (= i 20000) acc (loop (+ i 1) (cons i acc)))))
(check (string-length (w write long)) 108891)
;; equal? terminates on cycles and compares them as infinite trees
(define c2 (list 1 2 3 1 2 3))
(set-cdr! (cdr (cddr (cddr c2))) c2)
(define c3 (list 1 2 4))
(set-cdr! (cddr c3) c3)
(check (equal? c1 c1) #t)
(check (equal? c1 c2) #t)
(check (equal? c1 c3) #f)
(check (equal? cv (let ((v (vector 'a #f))) (vector-set! v 1 v) v)) #t)
(check (equal? cc (let ((x (list 'x))) (set-car! x x) x)) #t)
(check (equal? cc (list (list (list 'x)))) #f)
;; structures larger than the first pass's budget (120,000 pairs and vectors)
(define (biglist) (let loop ((i 0) (acc '())) (if (= i 60000) acc (loop (+ i 1) (cons (vector i) acc)))))
(check (equal? (biglist) (biglist)) #t)
(check (equal? (biglist) (cons 0 (biglist))) #f)
(check-done)
