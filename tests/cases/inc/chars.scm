;; Shared body of char_ascii.scm and char_unicode.scm: (scheme char) on ASCII and non-ASCII
;; characters, printed so that the two .out files show the --unicode=ascii / full difference.
(define (show label x) (display label) (display ": ") (write x) (newline))
(show "full-unicode feature" (cond-expand (full-unicode #t) (else #f)))
(show "features" (if (memq 'full-unicode (features)) 'listed 'absent))
(define cs (list #\a #\Z #\5 #\space #\x3BB #\x39B #\xDF #\x130 #\x17F #\x660 #\xFF15 #\x2003 #\xA0 #\x1F600))
(show "alphabetic" (map char-alphabetic? cs))
(show "numeric" (map char-numeric? cs))
(show "whitespace" (map char-whitespace? cs))
(show "upper-case" (map char-upper-case? cs))
(show "lower-case" (map char-lower-case? cs))
(show "digit-value" (map digit-value cs))
(show "upcase" (map char-upcase cs))
(show "downcase" (map char-downcase cs))
(show "foldcase" (map char-foldcase cs))
(show "string-upcase" (string-upcase "Straße ǰ ﬁ λάμδα"))
(show "string-downcase" (string-downcase "ΟΔΥΣΣΕΥΣ İ ABC"))
(show "string-foldcase" (string-foldcase "Straße ΣΊΣΥΦΟΣ ſ ẞ"))
(show "ci" (list (char-ci=? #\x3BB #\x39B) (string-ci=? "STRASSE" "straße") (string-ci<? "abc" "ABD")
                 (string-ci=? "ΧΑΟΣ" "χαος") (char-ci=? #\a #\A #\a)))
