;; Safe mode (spec 3.3): "it is an error" situations raise a catchable error object whose
;; message names the procedure, with the offending object as irritant.
(import (scheme base) (util check))

(define (id x) x)                     ; hides constants from compile-time type checks
(define (irritants thunk)
  (guard (e ((error-object? e) (list (error-object-message e) (error-object-irritants e))))
    (thunk)))
(check (irritants (lambda () (car (id 5)))) '("car: expected pair" (5)))
(check (irritants (lambda () (vector-ref (vector 1 2) (id 2)))) '("vector-ref: index out of range" (2)))
(check (irritants (lambda () (+ 1 (id "a")))) '("+: expected number" ("a")))
(check (irritants (lambda () (error "custom" 1 2))) '("custom" (1 2)))
(check-error "cdr" (cdr (id '())))
(check-error "set-car!" (set-car! (id 'x) 1))
(check-error "length" (length (id '(1 . 2))))
(check-error "length" (let ((l (list 1 2))) (set-cdr! (cdr l) l) (length l)))
(check-error "reverse" (reverse (id '(1 . 2))))
(check-error "append" (append (id '(1 . 2)) '(3)))
(check-error "list-tail" (list-tail '(1 2) (id 3)))
(check-error "list-ref" (list-ref '(1 2) (id 2)))
(check-error "list-set!" (list-set! (list 1) (id 1) 'x))
(check-error "make-list" (make-list (id -1)))
(check-error "vector-set!" (vector-set! (make-vector 2) (id 2) 0))
(check-error "vector-set!" (vector-set! (id #(1 2)) 0 0))
(check-error "make-vector" (make-vector (id -1)))
(check-error "vector->list" (vector->list (vector 1 2) (id 3)))
(check-error "vector-fill!" (vector-fill! (make-vector 2) 0 (id 3)))
(check-error "vector-copy" (vector-copy (vector 1 2) (id 3)))
(check-error "vector-copy!" (vector-copy! (make-vector 1) 0 (vector 1 2)))
(check-error "string-ref" (string-ref "abc" (id 3)))
(check-error "string-length" (string-length (id 'abc)))
(check-error "make-string" (make-string (id 2) (id "a")))
(check-error "substring" (substring "abc" 2 (id 1)))
(check-error "string-append" (string-append "a" (id 'b)))
(check-error "list->string" (list->string (list #\a (id 1))))
(check-error "string->symbol" (string->symbol (id 'a)))
(check-error "symbol->string" (symbol->string (id "a")))
(check-error "symbol=?" (symbol=? 'a (id "a")))
(check-error "boolean=?" (boolean=? #t (id 1)))
(check-error "char->integer" (char->integer (id "a")))
(check-error "integer->char" (integer->char (id #x110000)))
(check-error "bytevector-u8-ref" (bytevector-u8-ref (bytevector 1) (id 1)))
(check-error "bytevector-u8-set!" (bytevector-u8-set! (bytevector 1) 0 (id 256)))
(check-error "bytevector-copy!" (bytevector-copy! (bytevector 1) 0 (bytevector 1 2)))
(check-error "make-bytevector" (make-bytevector 1 (id -1)))
(check-error "utf8->string" (utf8->string (id "a")))
(check-error "exact" (exact (id 0.5)))
(check-error "exact-integer-sqrt" (exact-integer-sqrt (id -1)))
(check-error "number->string" (number->string 10 (id 3)))
(check-error "numerator" (numerator (id +inf.0)))
(check-error "denominator" (denominator (id 'x)))
(check-error "quotient" (quotient 1 (id 0)))
(check-error "remainder" (remainder 1.5 (id 1)))
(check-error "modulo" (modulo 1 (id 0)))
(check-error "floor-quotient" (floor-quotient 1 (id 0)))
(check-error "<" (< 1 (id 'a)))
(check-error "=" (= (id 'a) 1))
(check-error "max" (max 1 (id 'a)))
(check-error "odd?" (odd? (id 1.5)))
(check-error "apply" (apply + 1 (id '(2 . 3))))
(check-error "read-char" (let ((p (open-input-string "a"))) (close-port p) (read-char p)))
(check-error "write-char" (let ((p (open-output-string))) (close-port p) (write-char #\a p)))
(check-error "read-line" (read-line (id (open-output-string))))
(check-error "read-string" (read-string (id -1) (open-input-string "")))
(check-error "error-object-message" (error-object-message (id 'x)))
(check-error "parameterize" (parameterize (((id car) 1)) 1))
(check-error "record accessor" (let () (define-record-type r (mk) r? (f r-f)) (r-f (id 5))))
;; calls: wrong argument count through an unknown call, and a non-procedure
(define (f a) a)
(check-error "f" ((id f)))
(check-error "lambda" ((id (lambda (a) a))))
(check (guard (e ((error-object? e) (error-object-message e))) ((id 5) 1)) "not a procedure")
;; raise of a non-error object, and a handler returning from raise
(check (guard (e ((symbol? e) e)) (raise 'boom)) 'boom)
(check (guard (e ((error-object? e) (error-object-irritants e)))
         (with-exception-handler (lambda (c) 0) (lambda () (raise 'again))))
       '(again))
(check-done)
