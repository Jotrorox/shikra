;; Continuations stored in data structures and called after the capturing procedure returned
;; (tier 3): in a list, a vector, a record and a hash of closures; plus local variables that
;; the program assigns: re-entry sees their current values (they are locations, not copies).
(import (scheme base) (scheme write))
(define-record-type cell (make-cell k) cell? (k cell-k set-cell-k!))
(define store (list #f))
(define vec (make-vector 1 #f))
(define rec (make-cell #f))
(define (capture-into! where)
  (let ((v (call/cc (lambda (k)
                      (case where
                        ((list) (set-car! store k))
                        ((vector) (vector-set! vec 0 k))
                        ((record) (set-cell-k! rec k))
                        ((closure) (set! store (list (lambda (x) (k x))))))
                      0))))
    (* v 10)))
(define results '())
(define (run where call)
  (let ((r (capture-into! where)))   ; capture-into! has returned when call runs
    (set! results (cons r results))
    (if (< r 30) (call (+ (quotient r 10) 1)))))
(run 'list (lambda (x) ((car store) x)))
(run 'vector (lambda (x) ((vector-ref vec 0) x)))
(run 'record (lambda (x) ((cell-k rec) x)))
(run 'closure (lambda (x) ((car store) x)))
(write (reverse results))
(newline)

;; assigned locals: the counter is a location shared by every re-entry
(define kk #f)
(define (counter-test)
  (let ((count 0) (trail '()))
    (call/cc (lambda (c) (set! kk c)))
    (set! count (+ count 1))
    (set! trail (cons count trail))
    (if (< count 5) (kk #f))
    trail))
(write (counter-test))
(newline)
(define (loop-test)
  (let ((acc '()))
    (do ((i 0 (+ i 1))) ((= i 3))
      (call/cc (lambda (c) (if (= i 1) (set! kk c))))
      (set! acc (cons i acc)))
    acc))
(define once #f)
(let ((r (loop-test)))
  (write r)
  (if (not once) (begin (set! once #t) (kk #f))))
(newline)
