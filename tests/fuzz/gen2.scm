;; tests/fuzz/gen2.scm SEED -- random programs for the flow analysis and what it enables (M4-2):
;; fixnum and flonum arithmetic mixed, near the fixnum limits and with NaN, infinities and -0.0;
;; type-dispatching code; variables given different types on different paths; records; calls
;; through known, passed and stored procedures; values and let-values through known and unknown
;; procedures; flonums crossing between unboxed and boxed homes (pairs, vectors, closures,
;; unknown procedures, recursive procedures). Errors are caught by guard (some programs install
;; no handler at all, so an error ends them: the uncaught report must agree too).
(import (scheme base) (scheme write) (scheme process-context))

(define seed (string->number (cadr (command-line))))
(define (rand n)
  (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648))
  (modulo (quotient seed 65536) n))
(define (pick l) (list-ref l (rand (length l))))
(define counter 0)
(define (fresh base) (set! counter (+ counter 1)) (string->symbol (string-append base (number->string counter))))
(define guards (= 0 (rand 4))) ; else no handler is ever installed

(define (lit)
  (pick '(0 1 -1 2 7 -3 1000 4611686018427387903 -4611686018427387904 4611686018427387900 2305843009213693952
          0.0 -0.0 1.5 -2.25 0.1 1e300 -1e300 +inf.0 -inf.0 +nan.0 3.0
          #\a "ab" sym () #t #f)))
(define (atom vars) (if (and (pair? vars) (< (rand 3) 2)) (pick vars) (let ((x (lit))) (if (or (symbol? x) (null? x)) `',x x))))
(define (num e) `(let ((t ,e)) (if (number? t) t 1)))
(define (fix e) `(let ((t ,e)) (if (exact-integer? t) t 3)))
(define (flo e) `(let ((t ,e)) (if (and (real? t) (inexact? t)) t 0.5)))
(define (expr vars d procs)
  (if (<= d 0)
      (atom vars)
      (let ((e (lambda () (expr vars (- d 1) procs))))
        (case (rand 34)
          ((0) (atom vars))
          ((1) `(+ ,(num (e)) ,(num (e))))
          ((2) `(- ,(num (e)) ,(num (e))))
          ((3) `(* ,(num (e)) ,(num (e))))
          ((4) `(/ ,(flo (e)) ,(num (e))))
          ((5) `(if (< ,(num (e)) ,(num (e))) ,(e) ,(e)))
          ((6) `(+ ,(fix (e)) 1))
          ((7) (let ((i (fresh "i")) (acc (fresh "acc")) (loop (fresh "loop")))
                 `(let ,loop ((,i 0) (,acc ,(flo (e))))
                    (if (< ,i ,(+ 1 (rand 5))) (,loop (+ ,i 1) (+ ,acc (* ,acc 0.5) ,(num (expr (cons i vars) (- d 1) procs)))) ,acc))))
          ((8) (let ((v (fresh "v"))) `(let ((,v (if (< ,(num (e)) 0) ,(e) ,(e)))) ,(expr (cons v vars) (- d 1) procs))))
          ((9) (let ((v (fresh "s"))) `(let ((,v ,(e))) (set! ,v ,(e)) ,(expr (cons v vars) (- d 1) procs))))
          ((10) (let ((x (fresh "x")))
                  `(let ((,x ,(e)))
                     (cond ((exact-integer? ,x) (- ,x 1)) ((real? ,x) (* ,x 2.0)) ((pair? ,x) (car ,x))
                           ((string? ,x) (string-length ,x)) ((char? ,x) (char->integer ,x)) (else (list ,x))))))
          ((11) `(car (cons ,(e) ,(e))))
          ((12) (let ((v (fresh "vec"))) `(let ((,v (vector ,(e) ,(e)))) (vector-set! ,v 1 ,(e)) (vector-ref ,v ,(rand 2)))))
          ((13) (let ((x (fresh "x")) (f (fresh "f"))) `(let ((,f (lambda (,x) (* ,x 2.0)))) (,f ,(num (e))))))
          ((14) (let ((x (fresh "x")) (fs (fresh "fs")))
                  `(let ((,fs (list (lambda (,x) (+ ,x 1)) (lambda (,x) (* ,x 1.5)))))
                     ((list-ref ,fs ,(rand 2)) ,(num (e))))))
          ((15) `(pt-x (make-pt ,(e) ,(e))))
          ((16) (let ((r (fresh "r"))) `(let ((,r ,(if (= 0 (rand 2)) `(make-pt ,(e) ,(e)) (e)))) (if (pt? ,r) (pt-y ,r) ,r))))
          ((17) (let ((a (fresh "a")) (b (fresh "b"))) `(let-values (((,a ,b) (two ,(e) ,(e)))) (list ,b ,a))))
          ((18) `(call-with-values (lambda () (two ,(e) ,(e))) (if (< ,(num (e)) 0) list vector)))
          ((19) (let ((a (fresh "a")) (b (fresh "b"))) `(let-values (((,a ,b) (divm (remainder ,(fix (e)) 50) ,(+ 1 (rand 5))))) (+ ,a ,b))))
          ((20) (let ((c (fresh "c"))) `(let ((,c (lambda () ,(flo (e))))) (+ (,c) (,c)))))
          ((21) `(eqv? ,(e) ,(e)))
          ((22) `(equal? (list ,(e)) (list ,(e))))
          ((23) `(begin (out ,(e)) ,(e)))
          ((24) (if (null? procs) (e) (let ((p (pick procs))) `(,(car p) ,@(map (lambda (_) (e)) (cdr p))))))
          ((25) `(fsum ,(rand 6) ,(flo (e))))
          ((26) `(inexact ,(fix (e))))
          ((27) `(abs ,(num (e))))
          ((28) `(sqrt ,(flo (e))))
          ((29) `(max ,(num (e)) ,(num (e))))
          ((30) `(if (pair? ,(e)) 'p 'np))
          ((31) `(string-append "s" (if (string? ,(e)) "y" "n")))
          ((32) (if guards `(guard (e (#t (if (error-object? e) (error-object-message e) e))) (car ,(e))) `(car (cons ,(e) 0))))
          (else (if guards `(guard (e (#t (if (error-object? e) (error-object-message e) e))) (+ ,(e) ,(e))) `(- ,(fix (e)) ,(fix (e)))))))))

(define (gen-procs n)
  (let loop ((i 0) (procs '()) (defs '()))
    (if (= i n)
        (cons (reverse procs) (reverse defs))
        (let* ((name (fresh "f"))
               (params (let pl ((k (+ 1 (rand 3))) (acc '())) (if (= k 0) acc (pl (- k 1) (cons (fresh "p") acc)))))
               (body (expr params (+ 2 (rand 3)) procs)))
          (loop (+ i 1) (cons (cons name params) procs) (cons `(define (,name ,@params) ,body) defs))))))

(define (main)
  (let* ((r (gen-procs (+ 2 (rand 4))))
         (procs (car r)) (defs (cdr r)))
    (for-each (lambda (d) (write d) (newline))
              '((import (scheme base) (scheme write) (scheme inexact))
                (define (out x) (write x) (newline))
                (define-record-type pt (make-pt x y) pt? (x pt-x) (y pt-y))
                (define (two a b) (values a b))
                (define (divm a b) (if (< a b) (values 0 a) (let-values (((q r) (divm (- a b) b))) (values (+ q 1) r))))
                (define (fsum n x) (if (= n 0) x (+ x (fsum (- n 1) (* x 0.5)))))))
    (for-each (lambda (d) (write d) (newline)) defs)
    (let loop ((k (+ 2 (rand 4))))
      (if (> k 0)
          (begin (write `(out ,(expr '() 3 procs))) (newline) (loop (- k 1)))))))
(main)
