;; tests/fuzz/gen.scm SEED -- prints a random terminating Scheme program built from the
;; features the optimizer rewrites (inlining, loops, closures with set!, higher-order library
;; procedures with lambdas, call/cc escapes, letrec state machines, case-lambda, vectors,
;; effects in arguments). Run by tests/fuzz.sh under `shikra interp` (the reference).
(import (scheme base) (scheme write) (scheme process-context))

(define seed (string->number (cadr (command-line))))
(define (rand n) ; LCG, 31 bits
  (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648))
  (modulo (quotient seed 65536) n))
(define (pick l) (list-ref l (rand (length l))))
(define counter 0)
(define (fresh base) (set! counter (+ counter 1)) (string->symbol (string-append base (number->string counter))))

;; (expr vars depth procs) -> an integer-valued expression
(define (atom vars)
  (if (and (pair? vars) (< (rand 3) 2)) (pick vars) (- (rand 20) 5)))
(define (small e) `(remainder ,e 1009))
(define (expr vars d procs)
  (if (<= d 0)
      (atom vars)
      (let ((e (lambda () (expr vars (- d 1) procs))))
        (case (rand 28)
          ((0 1) (atom vars))
          ((2) `(+ ,(e) ,(e)))
          ((3) `(- ,(e) ,(e) ,(e)))
          ((4) (small `(* ,(e) ,(e))))
          ((5) `(if (< ,(e) ,(e)) ,(e) ,(e)))
          ((6) (let ((v (fresh "v"))) `(let ((,v ,(e))) ,(expr (cons v vars) (- d 1) procs))))
          ((7) (let ((i (fresh "i")) (acc (fresh "acc")) (loop (fresh "loop")))
                 `(let ,loop ((,i 0) (,acc ,(e)))
                    (if (>= ,i ,(+ 1 (rand 6))) ,acc
                        (,loop (+ ,i 1) ,(small `(+ ,acc ,(expr (cons i (cons acc vars)) (- d 1) procs))))))))
          ((8) (let ((v (fresh "v"))) `((lambda (,v) ,(expr (cons v vars) (- d 1) procs)) ,(e))))
          ((9) (let ((v (fresh "s")))
                 `(let ((,v ,(e))) (set! ,v ,(small `(+ ,v ,(expr (cons v vars) (- d 1) procs)))) ,v)))
          ((10) (let ((g (fresh "g")) (v (fresh "v")))
                  `(let ((,g (lambda (,v) ,(expr (cons v vars) (- d 1) procs)))) (+ (,g ,(e)) (,g ,(e))))))
          ((11) (let ((c (fresh "c")) (inc (fresh "inc")) (dv (fresh "d")))
                  `(let ((,c ,(e))) (let ((,inc (lambda (,dv) (set! ,c ,(small `(+ ,c ,dv))) ,c))) (,inc ,(e)) (,inc ,(e))))))
          ((12) (let ((s (fresh "s")) (x (fresh "x")))
                  `(let ((,s 0)) (for-each (lambda (,x) (set! ,s ,(small `(+ ,s ,(expr (cons x vars) (- d 1) procs))))) (list ,(e) ,(e) ,(e))) ,s)))
          ((13) (let ((x (fresh "x")))
                  `(apply + (map (lambda (,x) ,(expr (cons x vars) (- d 1) procs)) (list ,(e) ,(e))))))
          ((14) (let ((k (fresh "k")))
                  `(call/cc (lambda (,k) (+ ,(e) (if (< ,(e) ,(e)) (,k ,(e)) ,(e)))))))
          ((15) (let ((k (fresh "k")) (x (fresh "x")))
                  `(call/cc (lambda (,k) (for-each (lambda (,x) (if (> ,x ,(e)) (,k ,x))) (list ,(e) ,(e) ,(e))) ,(e)))))
          ((16) (let ((v (fresh "vec")))
                  `(let ((,v (make-vector 3 ,(e)))) (vector-set! ,v ,(rand 3) ,(e)) (+ (vector-ref ,v 0) (vector-ref ,v ,(rand 3))))))
          ((17 18) (if (null? procs) (e)
                       (let ((p (pick procs))) `(,(car p) ,@(map (lambda (_) (e)) (cdr p))))))
          ((19) (let ((ev (fresh "ev")) (od (fresh "od")) (n (fresh "n")))
                  `(letrec ((,ev (lambda (,n) (if (= ,n 0) ,(e) (,od (- ,n 1)))))
                            (,od (lambda (,n) (if (= ,n 0) ,(e) (,ev (- ,n 1))))))
                     (,ev (remainder (abs ,(e)) 25)))))
          ((20) (let ((h (fresh "h")))
                  `(let ((,h (case-lambda ((a) (- a 1)) ((a b) (+ a b)) ((a . r) (length r)))))
                     (+ (,h ,(e)) (,h ,(e) ,(e)) (,h ,(e) ,(e) ,(e))))))
          ((21) `(begin (out ,(e)) ,(e)))
          ((22) (let ((v (fresh "v")) (w (fresh "w")))
                  `(let* ((,v ,(e)) (,w (lambda () ,v))) (set! ,v (+ ,v 1)) (+ (,w) ,v))))
          ((23) (let ((k (fresh "k")) (i (fresh "i")) (loop (fresh "loop")))
                  `(call/cc (lambda (,k) (let ,loop ((,i 0)) (if (> ,i 50) ,(e) (begin (if (= ,i ,(rand 60)) (,k ,i)) (,loop (+ ,i 1)))))))))
          ((24) (let ((ps (fresh "ps")) (i (fresh "i")) (loop (fresh "loop")) (p (fresh "p")))
                  `(let ((,ps (let ,loop ((,i 0) (acc '())) (if (= ,i 3) acc (,loop (+ ,i 1) (cons (lambda () (+ ,i ,(e))) acc))))))
                     (apply + (map (lambda (,p) (,p)) ,ps)))))
          ((25) (let ((rec (fresh "rec")) (n (fresh "n")))
                  `(let ,rec ((,n (remainder (abs ,(e)) 12))) (if (<= ,n 0) ,(e) (+ ,n (,rec (- ,n 1)))))))
          ((26) (let ((l1 (fresh "loop")) (l2 (fresh "loop")) (i (fresh "i")) (j (fresh "j")))
                  `(+ (let ,l1 ((,i ,(rand 4))) (if (= ,i 0) ,(e) (,l1 (- ,i 1))))
                      (let ,l2 ((,j ,(rand 4)) (acc ,(e))) (if (= ,j 0) acc (,l2 (- ,j 1) (+ acc ,j)))))))
          (else `(vector-length (vector ,(e) ,(e))))))))

(define (gen-procs n)
  (let loop ((i 0) (procs '()) (defs '()))
    (if (= i n)
        (cons (reverse procs) (reverse defs))
        (let* ((name (fresh "f"))
               (params (let pl ((k (+ 1 (rand 3))) (acc '())) (if (= k 0) acc (pl (- k 1) (cons (fresh "p") acc)))))
               (body (expr params (+ 2 (rand 3)) procs)))
          (loop (+ i 1) (cons (cons name params) procs) (cons `(define (,name ,@params) ,body) defs))))))

(define (main)
  (let* ((r (gen-procs (+ 2 (rand 5))))
         (procs (car r)) (defs (cdr r)))
    (write '(import (scheme base) (scheme case-lambda) (scheme write))) (newline)
    (write '(define (out x) (write x) (newline))) (newline)
    (for-each (lambda (d) (write d) (newline)) defs)
    (let loop ((k (+ 2 (rand 4))))
      (if (> k 0)
          (begin (write `(out ,(expr '() 3 procs))) (newline) (loop (- k 1)))))))
(main)
