;; tests/fuzz/gen3.scm SEED -- prints a random terminating Scheme program built around call/cc
;; (tier 3, M5): escape-only continuations passed to helpers, through dynamic-wind (with a
;; trace), exception handlers, guard, map and loops (tiers 1 and 2), stored continuations used
;; as escapes, and re-entrant ones -- re-entering a stored continuation, also inside map and
;; dynamic-wind -- each bounded by its own global counter so the program terminates. Run by
;; tests/fuzz.sh under `shikra interp` (the reference).
(import (scheme base) (scheme write) (scheme process-context))

(define seed (string->number (cadr (command-line))))
(define (rand n) ; LCG, 31 bits
  (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648))
  (modulo (quotient seed 65536) n))
(define (pick l) (list-ref l (rand (length l))))
(define counter 0)
(define (fresh base) (set! counter (+ counter 1)) (string->symbol (string-append base (number->string counter))))
(define globals '()) ; (name . initial value) of the stored continuations and the counters
(define (global base init) (let ((g (fresh base))) (set! globals (cons (cons g init) globals)) g))
(define reentries 0) ; at most 3 re-entry patterns per program (each re-runs what follows it)

(define (atom vars) (if (and (pair? vars) (< (rand 3) 2)) (pick vars) (- (rand 20) 5)))
(define (small e) `(remainder ,e 1009))
(define (expr vars d procs)
  (if (<= d 0)
      (atom vars)
      (let ((e (lambda () (expr vars (- d 1) procs)))
            (sub (lambda (v) (expr (cons v vars) (- d 1) procs))))
        (case (rand 24)
          ((0 1) (atom vars))
          ((2) `(+ ,(e) ,(e)))
          ((3) (small `(* ,(e) ,(e))))
          ((4) `(if (< ,(e) ,(e)) ,(e) ,(e)))
          ((5) (let ((v (fresh "v"))) `(let ((,v ,(e))) ,(sub v))))
          ((6) (let ((i (fresh "i")) (acc (fresh "acc")) (loop (fresh "loop")))
                 `(let ,loop ((,i 0) (,acc ,(e)))
                    (if (>= ,i ,(+ 1 (rand 4))) ,acc
                        (,loop (+ ,i 1) ,(small `(+ ,acc ,(expr (cons i (cons acc vars)) (- d 1) procs))))))))
          ((7 8) (if (null? procs) (e) (let ((p (pick procs))) `(,(car p) ,@(map (lambda (_) (e)) (cdr p))))))
          ((9) `(begin (out ,(e)) ,(e)))
          ;; escapes: k passed down to a helper, a loop, for-each, map
          ((10) (let ((k (fresh "k"))) `(call/cc (lambda (,k) (+ ,(e) (esc-if ,k ,(e) ,(e)))))))
          ((11) (let ((k (fresh "k")) (x (fresh "x")))
                  `(call/cc (lambda (,k) (apply + (map (lambda (,x) (if (> ,x ,(e)) (,k ,x) ,x)) (list ,(e) ,(e) ,(e))))))))
          ((12) (let ((k (fresh "k")) (i (fresh "i")) (loop (fresh "loop")))
                  `(call/cc (lambda (,k) (let ,loop ((,i 0)) (if (> ,i 20) ,(e) (begin (esc-if ,k ,i ,(rand 25)) (,loop (+ ,i 1)))))))))
          ;; escapes through dynamic-wind (traced), a handler, guard
          ((13) (let ((k (fresh "k")) (t (rand 100)))
                  `(call/cc (lambda (,k) (dynamic-wind (lambda () (out '(in ,t))) (lambda () (+ ,(e) (esc-if ,k ,(e) ,(e)))) (lambda () (out '(out ,t))))))))
          ((14) (let ((k (fresh "k")) (c (fresh "c")))
                  `(call/cc (lambda (,k) (with-exception-handler (lambda (,c) (,k (+ ,c 1))) (lambda () (+ 1 (raise-if ,(e) ,(e)))))))))
          ((15) (let ((c (fresh "c")))
                  `(guard (,c ((number? ,c) (- ,c 1))) (+ 2 (raise-if ,(e) ,(e))))))
          ((16) (let ((k (fresh "k")) (c (fresh "c")))
                  `(call/cc (lambda (,k) (guard (,c (#t (,k ,c))) (+ 3 (raise-if ,(e) ,(e))))))))
          ;; a stored continuation used only as an escape (tier 3)
          ((17) (let ((k (fresh "k")) (g (global "gk" #f)))
                  `(call/cc (lambda (,k) (set! ,g ,k) (+ ,(e) (esc-if ,g ,(e) ,(e)))))))
          ;; re-entry: the continuation is called again after its call/cc returned
          ((18 19) (if (>= reentries 3) (e)
                       (let ((k (fresh "k")) (r (fresh "r")) (g (global "gk" #f)) (n (global "cnt" 0)))
                         (set! reentries (+ reentries 1))
                         `(let ((,r (call/cc (lambda (,k) (set! ,g ,k) ,(e)))))
                            (set! ,n (+ ,n 1))
                            (if (< ,n ,(+ 2 (rand 2))) (,g (+ ,r ,n)) ,r)))))
          ((20) (if (>= reentries 3) (e)
                    (let ((k (fresh "k")) (r (fresh "r")) (x (fresh "x")) (g (global "gk" #f)) (n (global "cnt" 0)))
                      (set! reentries (+ reentries 1))
                      `(let ((,r (map (lambda (,x) (call/cc (lambda (,k) (if (= ,x 2) (set! ,g ,k)) (+ ,x ,(e))))) (list 1 2 3))))
                         (set! ,n (+ ,n 1))
                         (if (< ,n 3) (,g (* 10 ,n)) (apply + ,r))))))
          ((21) (if (>= reentries 3) (e)
                    (let ((k (fresh "k")) (r (fresh "r")) (g (global "gk" #f)) (n (global "cnt" 0)) (t (rand 100)))
                      (set! reentries (+ reentries 1))
                      `(let ((,r (dynamic-wind (lambda () (out '(enter ,t)))
                                               (lambda () (call/cc (lambda (,k) (set! ,g ,k) ,(e))))
                                               (lambda () (out '(leave ,t))))))
                         (set! ,n (+ ,n 1))
                         (if (< ,n 3) (,g (- ,r ,n)) ,r)))))
          ;; an assigned local updated across a re-entry point
          ((22) (let ((s (fresh "s"))) `(let ((,s ,(e))) (set! ,s ,(small `(+ ,s ,(sub s)))) ,s)))
          (else `(vector-length (vector ,(e) ,(e))))))))

(define (gen-procs n)
  (let loop ((i 0) (procs '()) (defs '()))
    (if (= i n)
        (cons (reverse procs) (reverse defs))
        (let* ((name (fresh "f"))
               (params (let pl ((k (+ 1 (rand 3))) (acc '())) (if (= k 0) acc (pl (- k 1) (cons (fresh "p") acc)))))
               (body (expr params (+ 2 (rand 3)) procs)))
          (loop (+ i 1) (cons (cons name params) procs) (cons `(define (,name ,@params) ,body) defs))))))

(define (main)
  (let* ((r (gen-procs (+ 1 (rand 4))))
         (procs (car r)) (defs (cdr r))
         (body (let loop ((k (+ 2 (rand 4))) (acc '()))
                 (if (> k 0) (loop (- k 1) (cons `(out ,(expr '() 3 procs)) acc)) (reverse acc)))))
    (write '(import (scheme base) (scheme write))) (newline)
    (write '(define (out x) (write x) (newline))) (newline)
    (write '(define (esc-if k x limit) (if (> x limit) (k x) x))) (newline)
    (write '(define (raise-if x limit) (if (> x limit) (raise x) x))) (newline)
    (for-each (lambda (g) (write `(define ,(car g) ,(cdr g))) (newline)) (reverse globals))
    (for-each (lambda (d) (write d) (newline)) defs)
    (for-each (lambda (f) (write f) (newline)) body)))
(main)
