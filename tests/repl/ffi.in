(import (shikra ffi) (shikra flonum) (shikra fixnum) (shikra f64vector) (shikra assume))
(define-c c-hypot "hypot" (double double) double)
(c-hypot 3.0 4.0)
(fl+ (c-hypot 5.0 12.0) 0.5)
(define-c c-sqrtf "sqrtf" (float) float)
(define-c c-nope "shikra_no_such_function" (int) int)
(define-c c-seven "fmax" (double double double double double double double double double) double)
(fx+ fx-greatest 1)
(assume (fx<? 2 1) "not so")
#f64(1 2 3)
(f64vector-ref (f64vector 1.5) 0)
