(define (loop i acc) (if (= i 0) acc (loop (- i 1) (+ acc 1))))
(loop 1000000 0)
(define (deep n) (if (= n 0) 0 (+ 1 (deep (- n 1)))))
(deep 100000)
(define (count-down n) (do ((i n (- i 1))) ((= i 0) 'done)))
(count-down 1000000)
(length (apply list (make-list 100000 'x)))
(define (mutual-even? n) (if (= n 0) #t (mutual-odd? (- n 1))))
(define (mutual-odd? n) (if (= n 0) #f (mutual-even? (- n 1))))
(mutual-even? 1000001)
