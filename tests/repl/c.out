    if (RT_UNLIKELY(argc != 1)) rt_arity_error("count-to", argc);
    v_n_N = a0;
    v_i_N = (intptr_t)RT_FIX(0);
jN:;
    v_t_N = rt_lt((obj)(v_i_N), v_n_N);
    if (v_t_N != RT_FALSE) {
        v_t_N = rt_fxadd(v_i_N, (intptr_t)RT_FIX(1));
        v_i_N = v_t_N;
        goto jN;
