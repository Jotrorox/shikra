;; tests/unit/flmath.scm -- accuracy of (shikra flonum)'s own math functions against the host libm
;; (bound with define-c), over N pseudo-random arguments per function and range plus special
;; values. Prints one line per function: the largest error in ulps (elementary functions) or the
;; largest relative error (special functions; Bessel: relative where |f| >= 1e-3 of the local
;; envelope, else absolute), then FAIL lines for errors above the pinned bound, and "flmath: ok".
;; Built and run by tests/run.sh unit (compiled: libm is linked into every program).
(import (scheme base) (scheme write) (scheme process-context) (shikra flonum) (shikra fixnum) (shikra ffi))
(define-c c-cbrt "cbrt" (double) double)
(define-c c-hypot "hypot" (double double) double)
(define-c c-expm1 "expm1" (double) double)
(define-c c-log1p "log1p" (double) double)
(define-c c-log2 "log2" (double) double)
(define-c c-log10 "log10" (double) double)
(define-c c-sinh "sinh" (double) double)
(define-c c-cosh "cosh" (double) double)
(define-c c-tanh "tanh" (double) double)
(define-c c-asinh "asinh" (double) double)
(define-c c-acosh "acosh" (double) double)
(define-c c-atanh "atanh" (double) double)
(define-c c-tgamma "tgamma" (double) double)
;; reference log-gamma: log |tgamma| where that is finite (macOS lgamma is off by up to 2.5e-13
;; relative near x = -1) for x < 0, else lgamma
(define (ref-lgamma x) (let ((g (c-tgamma x))) (if (and (fl<? x 0.0) (flfinite? g) (not (fl=? g 0.0))) (fllog (flabs g)) (c-lgamma x))))
(define-c c-lgamma "lgamma" (double) double)
(define-c c-erf "erf" (double) double)
(define-c c-erfc "erfc" (double) double)
(define-c c-jn "jn" (int double) double)
(define-c c-yn "yn" (int double) double)
(define-c c-fma "fma" (double double double) double)
(define-c c-fmod "fmod" (double double) double)
(define-c c-remainder "remainder" (double double) double)
(define-c c-nextafter "nextafter" (double double) double)
(define-c c-ldexp "ldexp" (double int) double)
(define-c c-logb "logb" (double) double)

(define n (let ((a (command-line))) (if (pair? (cdr a)) (string->number (cadr a)) 100000)))
(define seed 88172645463325252)
(define (rnd) ; xorshift on 62 bits, as fixnums
  (set! seed (fxxor seed (fxand (fxarithmetic-shift-left (fxand seed #x7FFFFFFFFF) 13) #x3FFFFFFFFFFFFFFF)))
  (set! seed (fxxor seed (fxarithmetic-shift-right seed 7)))
  (set! seed (fxxor seed (fxand (fxarithmetic-shift-left (fxand seed #x1FFFFFFFFFFF) 17) #x3FFFFFFFFFFFFFFF)))
  seed)
(define (unif lo hi) (fl+ lo (fl* (fl- hi lo) (fl/ (inexact (fxand (rnd) #xFFFFFFFFFFFFF)) 4503599627370496.0))))
(define (logu lo hi) (flexp (unif (fllog lo) (fllog hi)))) ; lo, hi > 0
(define (ulps a b) ; |a - b| in units of b's last place
  (cond ((and (flnan? a) (flnan? b)) 0.0)
        ((fl=? a b) 0.0)
        ((or (flnan? a) (flnan? b) (flinfinite? a) (flinfinite? b)) 1e300)
        (else (fl/ (flabs (fl- a b)) (flabs (fl- (fladjacent b +inf.0) b))))))
(define (rel a b)
  (cond ((and (flnan? a) (flnan? b)) 0.0)
        ((fl=? a b) 0.0)
        ((or (flnan? a) (flnan? b) (flinfinite? a) (flinfinite? b)) 1e300)
        (else (fl/ (flabs (fl- a b)) (flabs b)))))
(define failures 0)
(define (report name err worst bound unit)
  (display name) (display ": max ") (write err) (display unit) (display " at ") (write worst) (newline)
  (when (fl>? err bound)
    (set! failures (+ failures 1))
    (display "FAIL: ") (display name) (display " error above ") (write bound) (newline)))
;; (check name mine libm measure bound unit gen ...): gen are thunks producing an argument
(define (check1 name mine ref measure bound unit gens specials)
  (let loop ((gs gens) (err 0.0) (worst 0.0))
    (if (null? gs)
        (let sp ((s specials) (err err) (worst worst))
          (if (null? s)
              (report name err worst bound unit)
              (let ((e (measure (mine (car s)) (ref (car s)))))
                (if (fl>? e err) (sp (cdr s) e (car s)) (sp (cdr s) err worst)))))
        (let inner ((i 0) (err err) (worst worst))
          (if (= i n)
              (loop (cdr gs) err worst)
              (let* ((x ((car gs))) (e (measure (mine x) (ref x))))
                (if (fl>? e err) (inner (+ i 1) e x) (inner (+ i 1) err worst))))))))
;; The reference is the host libm, so two bounds are per platform (DESIGN.md "Integration"): on Linux
;; it is glibc's, whose cbrt is up to 3 ulp off (at -3.451216910111361 glibc gives -1.5112074476162218,
;; the exact value is -1.51120744761622124..., flcbrt -1.5112074476162212) and whose tanh is up to 2
;; ulp off (at 0.22472308731815804: glibc -1.91 ulp, fltanh +2.09 ulp from the exact value; macOS +0.09).
(define linux? (cond-expand (linux #t) (else #f)))
(define cbrt-bound (if linux? 3.0 1.0))
(define tanh-bound (if linux? 4.0 3.0))
(define specials '(0.0 -0.0 +inf.0 -inf.0 +nan.0 1.0 -1.0 0.5 2.0 1e-310 -1e-310 1e-300 1e300 -1e300 709.5 -745.0))

(check1 "flcbrt" flcbrt c-cbrt ulps cbrt-bound " ulp" (list (lambda () (unif -10.0 10.0)) (lambda () (logu 1e-300 1e300)) (lambda () (fl- 0.0 (logu 1e-310 1e-290)))) specials)
(check1 "flexp-1" flexp-1 c-expm1 ulps 2.0 " ulp" (list (lambda () (unif -1.0 1.0)) (lambda () (logu 1e-20 1e-3)) (lambda () (unif -40.0 709.0))) specials)
(check1 "fllog1+" fllog1+ c-log1p ulps 2.0 " ulp" (list (lambda () (unif -0.9 1.0)) (lambda () (fl* (if (fxodd? (rnd)) 1.0 -1.0) (logu 1e-20 1e-3))) (lambda () (logu 1.0 1e300))) specials)
(check1 "fllog2" fllog2 c-log2 ulps 3.0 " ulp" (list (lambda () (unif 0.5 2.0)) (lambda () (logu 1e-310 1e308))) specials)
(check1 "fllog10" fllog10 c-log10 ulps 3.0 " ulp" (list (lambda () (unif 0.5 2.0)) (lambda () (logu 1e-310 1e308))) specials)
(check1 "flsinh" flsinh c-sinh ulps 3.0 " ulp" (list (lambda () (unif -2.0 2.0)) (lambda () (logu 1e-20 1e-3)) (lambda () (unif -710.0 710.0))) specials)
(check1 "flcosh" flcosh c-cosh ulps 3.0 " ulp" (list (lambda () (unif -2.0 2.0)) (lambda () (unif -710.0 710.0))) specials)
(check1 "fltanh" fltanh c-tanh ulps tanh-bound " ulp" (list (lambda () (unif -2.0 2.0)) (lambda () (logu 1e-20 1e-3)) (lambda () (unif -25.0 25.0))) specials)
(check1 "flasinh" flasinh c-asinh ulps 3.0 " ulp" (list (lambda () (unif -4.0 4.0)) (lambda () (logu 1e-20 1e-3)) (lambda () (logu 1.0 1e300))) specials)
(check1 "flacosh" flacosh c-acosh ulps 3.0 " ulp" (list (lambda () (unif 1.0 4.0)) (lambda () (fl+ 1.0 (logu 1e-15 1e-3))) (lambda () (logu 1.0 1e300))) specials)
(check1 "flatanh" flatanh c-atanh ulps 3.0 " ulp" (list (lambda () (unif -1.0 1.0)) (lambda () (logu 1e-20 1e-3)) (lambda () (fl- 1.0 (logu 1e-16 1e-3)))) specials)
(check1 "flhypot" (lambda (p) (flhypot (car p) (cdr p))) (lambda (p) (c-hypot (car p) (cdr p))) ulps 1.0 " ulp"
        (list (lambda () (cons (unif -10.0 10.0) (unif -10.0 10.0))) (lambda () (cons (logu 1e-300 1e300) (logu 1e-300 1e300)))
              (lambda () (cons (logu 1e300 1.7e308) (logu 1e300 1.7e308))) (lambda () (cons (logu 1e-320 1e-300) (logu 1e-320 1e-300))))
        '((3.0 . 4.0) (+inf.0 . +nan.0) (+nan.0 . 1.0) (0.0 . 0.0) (1e308 . 1e308)))
(check1 "flgamma" flgamma c-tgamma rel 1e-13 " (relative)"
        (list (lambda () (unif 0.0 10.0)) (lambda () (unif 10.0 171.6)) (lambda () (unif -10.0 0.0)) (lambda () (unif -170.0 -10.0)) (lambda () (logu 1e-300 1e-5)))
        specials)
(check1 "flloggamma" (lambda (x) (call-with-values (lambda () (flloggamma x)) (lambda (l s) l))) ref-lgamma rel 1e-13 " (relative)"
        (list (lambda () (unif 0.0 10.0)) (lambda () (logu 10.0 1e300)) (lambda () (unif 0.9 1.1)) (lambda () (unif 1.9 2.1)) (lambda () (unif -2.0 0.0)))
        specials)
(check1 "flloggamma, x < -2" (lambda (x) (call-with-values (lambda () (flloggamma x)) (lambda (l s) l))) ref-lgamma
        (lambda (a b) (fl/ (flabs (fl- a b)) (flmax 1.0 (flabs b)))) 1e-13 " (relative, absolute below 1)"
        (list (lambda () (unif -100.0 -2.0))) '(-2.5 -3.5))
(check1 "flerf" flerf c-erf ulps 6.0 " ulp" (list (lambda () (unif -3.0 3.0)) (lambda () (logu 1e-300 1e-3)) (lambda () (unif -7.0 7.0))) specials)
(check1 "flerfc" flerfc c-erfc (lambda (a b) (if (fl<? (flabs b) 2.2250738585072014e-308) (fl* 1e-16 (ulps a b)) (rel a b))) 1e-13 " (relative; 1e-16 per ulp for subnormal results)" (list (lambda () (unif -3.0 3.0)) (lambda () (unif 0.0 27.0)) (lambda () (logu 1e-300 1e-3))) specials)
(define (bessel-env x) (flmin 1.0 (flsqrt (fl/ 0.6366197723675814 x))))
(define (bessel-gen lo hi nmax) (lambda () (cons (fxremainder (fxabs (rnd)) (+ nmax 1)) (unif lo hi))))
(define (bessel-check name mine ref bound)
  (let loop ((gs (list (bessel-gen 0.0 1.0 10) (bessel-gen 1.0 25.0 10) (bessel-gen 25.0 200.0 10) (bessel-gen 0.0 50.0 60)))
             (er 0.0) (ea 0.0) (worst '()))
    (if (null? gs)
        (begin (report (string-append name " (relative, away from zeros)") er worst bound "")
               (report (string-append name " (absolute, near zeros)") ea worst bound ""))
        (let inner ((i 0) (er er) (ea ea) (worst worst))
          (if (= i n)
              (loop (cdr gs) er ea worst)
              (let* ((p ((car gs))) (a (mine (car p) (cdr p))) (b (ref (car p) (cdr p))))
                (if (or (fl<? (flabs b) 1e-290) (flinfinite? b))
                    (inner (+ i 1) er ea worst)
                    (if (fl<? (flabs b) (fl* 0.1 (bessel-env (cdr p))))
                        (let ((e (flabs (fl- a b)))) (if (fl>? e ea) (inner (+ i 1) er e p) (inner (+ i 1) er ea worst)))
                        (let ((e (rel a b))) (if (fl>? e er) (inner (+ i 1) e ea p) (inner (+ i 1) er ea worst)))))))))))
(bessel-check "flfirst-bessel" flfirst-bessel c-jn 1e-12)
(bessel-check "flsecond-bessel" flsecond-bessel c-yn 1e-12)
;; the bit-level primitives must agree exactly
(define (exact-check name mine ref gen)
  (check1 name mine ref (lambda (a b) (if (eqv? a b) 0.0 (if (and (flnan? a) (flnan? b)) 0.0 1.0))) 0.0 "" (list gen) '()))
(define (rbits) (let ((h (fxand (rnd) #xFFFFFFF)) (l (fxand (rnd) #xFFFFFFFFF))) (make-flonum (inexact (+ 1 h)) (- (fxremainder l 2100) 1075))))
(exact-check "fl+*" (lambda (v) (fl+* (vector-ref v 0) (vector-ref v 1) (vector-ref v 2))) (lambda (v) (c-fma (vector-ref v 0) (vector-ref v 1) (vector-ref v 2)))
             (lambda () (let ((x (unif -10.0 10.0)) (y (unif -10.0 10.0))) (vector x y (fl- 0.0 (fl* x (fl* y (unif 0.999 1.001))))))))
(exact-check "flremainder" (lambda (p) (flremainder (car p) (cdr p))) (lambda (p) (c-fmod (car p) (cdr p))) (lambda () (cons (fl* (rbits) (unif -1.0 1.0)) (rbits))))
(exact-check "flremquo" (lambda (p) (call-with-values (lambda () (flremquo (car p) (cdr p))) (lambda (r q) r)))
             (lambda (p) (c-remainder (car p) (cdr p))) (lambda () (cons (fl* (rbits) (unif -1.0 1.0)) (rbits))))
(exact-check "fladjacent" (lambda (p) (fladjacent (car p) (cdr p))) (lambda (p) (c-nextafter (car p) (cdr p))) (lambda () (cons (fl* (rbits) (unif -1.0 1.0)) (unif -1.0 1.0))))
(exact-check "make-flonum" (lambda (p) (make-flonum (car p) (cdr p))) (lambda (p) (c-ldexp (car p) (cdr p))) (lambda () (cons (rbits) (- (fxremainder (fxabs (rnd)) 4400) 2200))))
(exact-check "flexponent" flexponent c-logb rbits)
(display (if (= failures 0) "flmath: ok" "flmath: FAILED")) (newline)
(exit (= failures 0))
