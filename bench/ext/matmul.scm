;; bench/ext/matmul.scm -- float kernel, portable R7RS: C = A * B for n x n matrices stored in
;; vectors of flonums (each element boxed), repeated; n and the repetitions from the command line.
(import (scheme base) (scheme write) (scheme process-context))
(define (arg k d) (let ((a (command-line))) (if (> (length a) k) (string->number (list-ref a k)) d)))
(define n (arg 1 400))
(define reps (arg 2 5))
(define (make-matrix f) (let ((m (make-vector (* n n) 0.0)))
  (do ((i 0 (+ i 1))) ((= i n) m) (do ((j 0 (+ j 1))) ((= j n)) (vector-set! m (+ (* i n) j) (f i j))))))
(define (matmul! c a b)
  (do ((i 0 (+ i 1))) ((= i n))
    (do ((j 0 (+ j 1))) ((= j n))
      (let loop ((k 0) (s 0.0))
        (if (< k n)
            (loop (+ k 1) (+ s (* (vector-ref a (+ (* i n) k)) (vector-ref b (+ (* k n) j)))))
            (vector-set! c (+ (* i n) j) s))))))
(define a (make-matrix (lambda (i j) (/ (+ i j 1.0) n))))
(define b (make-matrix (lambda (i j) (/ (- i j) (+ n 0.5)))))
(define c (make-matrix (lambda (i j) 0.0)))
(do ((r 0 (+ r 1))) ((= r reps)) (matmul! c a b))
(let loop ((i 0) (s 0.0)) (if (< i (* n n)) (loop (+ i 1) (+ s (vector-ref c i))) (begin (write s) (newline))))
