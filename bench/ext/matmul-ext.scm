;; bench/ext/matmul-ext.scm -- the same kernel with (shikra flonum) and (shikra f64vector): raw
;; doubles in memory and in registers. Guarded with cond-expand, so it runs on any R7RS system.
(import (scheme base) (scheme write) (scheme process-context))
(cond-expand
  (shikra (import (shikra flonum) (shikra f64vector) (shikra fixnum)))
  (else (begin (define fl+ +) (define fl* *) (define fl/ /) (define fl- -) (define fx+ +) (define fx* *) (define fx<? <)
               (define make-f64vector make-vector) (define f64vector-ref vector-ref) (define f64vector-set! vector-set!))))
(define (arg k d) (let ((a (command-line))) (if (> (length a) k) (string->number (list-ref a k)) d)))
(define n (arg 1 400))
(define reps (arg 2 5))
(define (make-matrix f) (let ((m (make-f64vector (* n n) 0.0)))
  (do ((i 0 (+ i 1))) ((= i n) m) (do ((j 0 (+ j 1))) ((= j n)) (f64vector-set! m (+ (* i n) j) (f i j))))))
(define (matmul! c a b)
  (do ((i 0 (fx+ i 1))) ((= i n))
    (do ((j 0 (fx+ j 1))) ((= j n))
      (let loop ((k 0) (s 0.0))
        (if (fx<? k n)
            (loop (fx+ k 1) (fl+ s (fl* (f64vector-ref a (fx+ (fx* i n) k)) (f64vector-ref b (fx+ (fx* k n) j)))))
            (f64vector-set! c (fx+ (fx* i n) j) s))))))
(define a (make-matrix (lambda (i j) (fl/ (inexact (+ i j 1)) (inexact n)))))
(define b (make-matrix (lambda (i j) (fl/ (inexact (- i j)) (fl+ (inexact n) 0.5)))))
(define c (make-matrix (lambda (i j) 0.0)))
(do ((r 0 (+ r 1))) ((= r reps)) (matmul! c a b))
(let loop ((i 0) (s 0.0)) (if (< i (* n n)) (loop (+ i 1) (fl+ s (f64vector-ref c i))) (begin (write s) (newline))))
